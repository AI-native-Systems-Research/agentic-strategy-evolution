--- a/solution.cpp
+++ b/solution.cpp
@@ -1,3 +1,157 @@
 #include <bits/stdc++.h>
 using namespace std;
-int main(){return 0;}
+
+static int N;
+static long long *X, *Y;
+static bool *isp;
+
+static auto START = chrono::steady_clock::now();
+static inline double ms() {
+    return chrono::duration<double,milli>(chrono::steady_clock::now()-START).count();
+}
+
+static inline double ddist(int a, int b) {
+    double dx = (double)(X[a]-X[b]), dy = (double)(Y[a]-Y[b]);
+    return sqrt(dx*dx+dy*dy);
+}
+
+int main() {
+    scanf("%d", &N);
+    X = new long long[N]; Y = new long long[N];
+    for (int i = 0; i < N; i++) scanf("%lld%lld", &X[i], &Y[i]);
+
+    START = chrono::steady_clock::now();
+
+    if (N <= 2) {
+        printf("%d\n", N+1);
+        for (int i = 0; i <= N; i++) printf("%d\n", i < N ? i : 0);
+        return 0;
+    }
+
+    // Sieve of Eratosthenes
+    isp = new bool[N]; fill(isp, isp+N, true);
+    isp[0] = false; if (N > 1) isp[1] = false;
+    for (int i = 2; (long long)i*i < N; i++)
+        if (isp[i]) for (int j = i*i; j < N; j += i) isp[j] = false;
+
+    // Bounding box
+    long long xlo = X[0], xhi = X[0], ylo = Y[0], yhi = Y[0];
+    for (int i = 1; i < N; i++) {
+        xlo = min(xlo, X[i]); xhi = max(xhi, X[i]);
+        ylo = min(ylo, Y[i]); yhi = max(yhi, Y[i]);
+    }
+    double W = max(1.0, (double)(xhi-xlo)), H = max(1.0, (double)(yhi-ylo));
+
+    // === CONSTRUCTION: Strip-based serpentine ===
+    int *tour = new int[N+2];
+    int *pos = new int[N];
+    {
+        vector<int> cit(N-1);
+        iota(cit.begin(), cit.end(), 1);
+        sort(cit.begin(), cit.end(), [](int a, int b) {
+            return Y[a] < Y[b] || (Y[a] == Y[b] && X[a] < X[b]);
+        });
+
+        int ns = max(1, (int)round(sqrt((double)(N-1)*H/W)));
+        ns = max(1, min(ns, N-1));
+
+        vector<vector<int>> strips(ns);
+        int M = N-1;
+        for (int i = 0; i < M; i++) {
+            int s = min((int)((long long)i*ns/M), ns-1);
+            strips[s].push_back(cit[i]);
+        }
+        for (int s = 0; s < ns; s++) {
+            sort(strips[s].begin(), strips[s].end(), [](int a, int b) {
+                return X[a] < X[b] || (X[a] == X[b] && Y[a] < Y[b]);
+            });
+            if (s % 2 == 1) reverse(strips[s].begin(), strips[s].end());
+        }
+
+        int ti = 0;
+        tour[ti++] = 0;
+        for (int s = 0; s < ns; s++)
+            for (int c : strips[s]) tour[ti++] = c;
+        tour[ti++] = 0;
+        for (int i = 0; i <= N; i++) pos[tour[i]] = i;
+    }
+
+    // === 2-opt window ===
+    int window;
+    if (N <= 200) window = N;
+    else if (N <= 1000) window = N/2;
+    else if (N <= 5000) window = 400;
+    else if (N <= 20000) window = 150;
+    else if (N <= 50000) window = 80;
+    else if (N <= 100000) window = 50;
+    else window = 30;
+
+    // === 2-opt local search ===
+    {
+        bool improved = true;
+        while (improved && ms() < 2100) {
+            improved = false;
+            for (int i = 0; i < N && ms() < 2100; i++) {
+                int jmax = min(i + window, N);
+                double d_i = ddist(tour[i], tour[i+1]);
+                for (int j = i+2; j <= jmax; j++) {
+                    double gain = d_i + ddist(tour[j], tour[j+1])
+                                - ddist(tour[i], tour[j]) - ddist(tour[i+1], tour[j+1]);
+                    if (gain > 1e-10) {
+                        int lo = i+1, hi = j;
+                        while (lo < hi) {
+                            swap(tour[lo], tour[hi]);
+                            pos[tour[lo]] = lo;
+                            pos[tour[hi]] = hi;
+                            lo++; hi--;
+                        }
+                        if (lo == hi) pos[tour[lo]] = lo;
+                        improved = true;
+                        d_i = ddist(tour[i], tour[i+1]);
+                    }
+                }
+            }
+        }
+    }
+
+    // === Carrot-aware prime placement ===
+    for (int p = 9; p < N; p += 10) {
+        if (isp[tour[p]]) continue;
+        double pen_edge = ddist(tour[p], tour[p+1]);
+        double savings = 0.1 * pen_edge;
+        int best = -1; double best_net = 0;
+        int sr = min(500, N/2);
+        for (int delta = 1; delta <= sr; delta++) {
+            for (int d : {-delta, delta}) {
+                int j = p + d;
+                if (j <= 0 || j >= N) continue;
+                if (!isp[tour[j]]) continue;
+                if (j >= 9 && j < N && (j+1) % 10 == 0) continue;
+                double old_c, new_c;
+                int u = tour[p], v = tour[j];
+                if (abs(p-j) > 1) {
+                    old_c = ddist(tour[p-1],u)+ddist(u,tour[p+1])
+                           +ddist(tour[j-1],v)+ddist(v,tour[j+1]);
+                    new_c = ddist(tour[p-1],v)+ddist(v,tour[p+1])
+                           +ddist(tour[j-1],u)+ddist(u,tour[j+1]);
+                } else if (j == p+1) {
+                    old_c = ddist(tour[p-1],u)+ddist(u,v)+ddist(v,tour[j+1]);
+                    new_c = ddist(tour[p-1],v)+ddist(v,u)+ddist(u,tour[j+1]);
+                } else {
+                    old_c = ddist(tour[j-1],v)+ddist(v,u)+ddist(u,tour[p+1]);
+                    new_c = ddist(tour[j-1],u)+ddist(u,v)+ddist(v,tour[p+1]);
+                }
+                double net = savings - (new_c - old_c);
+                if (net > best_net) { best_net = net; best = j; }
+            }
+        }
+        if (best >= 0) swap(tour[p], tour[best]);
+    }
+
+    // === Output ===
+    printf("%d\n", N+1);
+    for (int i = 0; i <= N; i++) printf("%d\n", tour[i]);
+
+    delete[] X; delete[] Y; delete[] isp; delete[] tour; delete[] pos;
+    return 0;
+}
