+int N;
+long long *px, *py;
+bool* isp;
+int K_NN;
+int* nn;
+
+inline double ddist(int a, int b) {
+    double dx = (double)(px[a]-px[b]), dy = (double)(py[a]-py[b]);
+    return sqrt(dx*dx+dy*dy);
+}
+
+// 2-opt with cycling detection, returns final unpenalized cost
+double do_nn2opt(int* tour, int* pos, double time_limit,
+                 chrono::steady_clock::time_point tick) {
+    auto elapsed=[&](){return chrono::duration<double,milli>(chrono::steady_clock::now()-tick).count();};
+    auto rawCost = [&]() -> double {
+        double t=0; for(int i=0;i<N;i++) t+=ddist(tour[i],tour[i+1]); return t;
+    };
+    double prev_cost = rawCost();
+    int prev_imp = -1;
+    for(int pass=0; pass<200 && elapsed()<time_limit; pass++){
+        int improvements = 0;
+        for(int i=0; i<N-1 && elapsed()<time_limit; i++){
+            int c = tour[i];
+            double d_ci = ddist(c, tour[i+1]);
+            int* nnp = nn + c*K_NN;
+            for(int k=0; k<K_NN; k++){
+                int nb = nnp[k];
+                if(nb<0) break;
+                int j = pos[nb];
+                if(j <= i+1 || j >= N) continue;
+                double gain = d_ci + ddist(tour[j], tour[j+1])
+                            - ddist(c, nb) - ddist(tour[i+1], tour[j+1]);
+                if(gain > 1e-10){
+                    for(int a=i+1, b=j; a<b; a++, b--){
+                        swap(tour[a], tour[b]);
+                        pos[tour[a]]=a; pos[tour[b]]=b;
+                    }
+                    if((i+1+j)%2==0){int m=(i+1+j)/2;pos[tour[m]]=m;}
+                    improvements++;
+                    d_ci = ddist(c, tour[i+1]);
+                }
+            }
+            int ci1 = tour[i+1];
+            nnp = nn + ci1*K_NN;
+            for(int k=0; k<K_NN; k++){
+                int nb = nnp[k];
+                if(nb<0) break;
+                int j = pos[nb];
+                if(j <= i+1 || j >= N) continue;
+                double gain = ddist(tour[i], tour[i+1]) + ddist(tour[j], tour[j+1])
+                            - ddist(tour[i], tour[j]) - ddist(tour[i+1], tour[j+1]);
+                if(gain > 1e-10){
+                    for(int a=i+1, b=j; a<b; a++, b--){
+                        swap(tour[a], tour[b]);
+                        pos[tour[a]]=a; pos[tour[b]]=b;
+                    }
+                    if((i+1+j)%2==0){int m=(i+1+j)/2;pos[tour[m]]=m;}
+                    improvements++;
+                }
+            }
+        }
+        if(improvements == 0) break;
+        // Cycling detection
+        if(pass >= 5 && (improvements == prev_imp || pass % 5 == 0)){
+            double cur_cost = rawCost();
+            if(cur_cost >= prev_cost * 0.99999) break;
+            prev_cost = cur_cost;
+        }
+        prev_imp = improvements;
+    }
+    return rawCost();
+}
+
+void nn_construct(int start, int* tour, int* pos) {
+    bool* visited = new bool[N]();
+    vector<int> chain; chain.reserve(N);
+    chain.push_back(start); visited[start] = true;
+    for(int step=1; step<N; step++){
+        int cur = chain.back();
+        int best = -1; double bestd = 1e30;
+        int* nnp = nn + cur*K_NN;
+        for(int k=0; k<K_NN; k++){
+            int nb = nnp[k];
+            if(nb<0) break;
+            if(!visited[nb]){
+                double d = ddist(cur, nb);
+                if(d<bestd){ bestd=d; best=nb; }
+            }
+        }
+        if(best<0){
+            for(int r=1;r<N;r++){
+                for(int d : {-r, r}){
+                    int nb = cur + d;
+                    if(nb>=0 && nb<N && !visited[nb]){
+                        double dd = ddist(cur, nb);
+                        if(dd<bestd){ bestd=dd; best=nb; }
+                    }
+                }
+                if(best>=0 && r>50) break;
+            }
+        }
+        chain.push_back(best);
+        visited[best] = true;
+    }
+    delete[] visited;
+
+    int zero_pos = -1;
+    for(int i=0;i<N;i++) if(chain[i]==0){ zero_pos=i; break; }
+
+    tour[0] = 0;
+    for(int i=1; i<N; i++){
+        tour[i] = chain[(zero_pos + i) % N];
+    }
+    tour[N] = 0;
+    for(int i=0;i<N;i++) pos[tour[i]] = i;
+}
+
+// Or-opt: relocate a single city to a better position using NN-list candidates
+// Returns number of improvements made
+int do_oropt1(int* tour, int* pos, double time_limit,
+              chrono::steady_clock::time_point tick) {
+    auto elapsed=[&](){return chrono::duration<double,milli>(chrono::steady_clock::now()-tick).count();};
+    int total_imp = 0;
+    for(int pass=0; pass<10 && elapsed()<time_limit; pass++){
+        int improvements = 0;
+        for(int i=1; i<N && elapsed()<time_limit; i++){
+            int c = tour[i];
+            // Cost of removing city c from position i
+            double remove_save = ddist(tour[i-1], c) + ddist(c, tour[i+1])
+                               - ddist(tour[i-1], tour[i+1]);
+            if(remove_save < 1e-10) continue; // removing doesn't help
+
+            // Try inserting c after each NN-list neighbor
+            int* nnp = nn + c*K_NN;
+            int best_q = -1;
+            double best_gain = 1e-10;
+            for(int k=0; k<K_NN; k++){
+                int nb = nnp[k];
+                if(nb<0) break;
+                int q = pos[nb];
+                // Try inserting c after position q
+                if(q == i || q == i-1) continue; // adjacent, no point
+                if(q >= N) continue; // skip last position (wraps to 0)
+                double insert_cost = ddist(tour[q], c) + ddist(c, tour[q+1])
+                                   - ddist(tour[q], tour[q+1]);
+                double gain = remove_save - insert_cost;
+                if(gain > best_gain){
+                    best_gain = gain;
+                    best_q = q;
+                }
+                // Also try inserting c before position q (i.e., after q-1)
+                if(q > 0 && q-1 != i && q-1 != i-1){
+                    insert_cost = ddist(tour[q-1], c) + ddist(c, tour[q])
+                                - ddist(tour[q-1], tour[q]);
+                    gain = remove_save - insert_cost;
+                    if(gain > best_gain){
+                        best_gain = gain;
+                        best_q = q-1;
+                    }
+                }
+            }
+            if(best_q >= 0){
+                // Perform the move: remove from i, insert after best_q
+                int city = tour[i];
+                if(best_q > i){
+                    // Shift left: tour[i+1..best_q] move to tour[i..best_q-1]
+                    for(int j=i; j<best_q; j++){
+                        tour[j] = tour[j+1];
+                        pos[tour[j]] = j;
+                    }
+                    tour[best_q] = city;
+                    pos[city] = best_q;
+                } else {
+                    // best_q < i-1: Shift right: tour[best_q+1..i-1] move to tour[best_q+2..i]
+                    for(int j=i; j>best_q+1; j--){
+                        tour[j] = tour[j-1];
+                        pos[tour[j]] = j;
+                    }
+                    tour[best_q+1] = city;
+                    pos[city] = best_q+1;
+                }
+                improvements++;
+            }
+        }
+        total_imp += improvements;
+        if(improvements == 0) break;
+    }
+    return total_imp;
+}
