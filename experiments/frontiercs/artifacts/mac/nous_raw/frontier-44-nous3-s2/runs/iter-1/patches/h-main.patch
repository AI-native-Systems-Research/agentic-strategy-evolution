+
+        // Find nearby cities in tour that are prime and not at penalty positions
+        int bestSwap = -1;
+        double bestDelta = 0;
+
+        int searchRange = min(100, N/2);
+        for (int offset = 1; offset <= searchRange; offset++) {
+            for (int dir = -1; dir <= 1; dir += 2) {
+                int qi = pi + dir * offset;
+                if (qi < 1 || qi >= N) continue;
+                if (!is_prime[tour[qi]]) continue;
+
+                // Check if qi is also a penalty position — if so, swapping doesn't help
