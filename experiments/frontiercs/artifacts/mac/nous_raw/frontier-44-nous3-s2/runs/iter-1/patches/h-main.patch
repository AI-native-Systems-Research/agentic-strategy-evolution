+                }
+
+            } else {
+                // 2-opt: reverse a segment
+                int i = 1 + rng.nextInt(N - 1);
+                int len = 2 + rng.nextInt(min(48, N - 2));
+                int j = i + len;
+                if (j >= N) continue;
+
+                // Edges affected: (i-1)->i and j->j+1 become (i-1)->j and i->j+1
+                // Plus all penalty positions in [i, j+1] change because cities shift
+
+                int lo = max(1, i - 1);
