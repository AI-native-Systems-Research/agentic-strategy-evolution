+                    int c = tour[i];
+                    for (int k = i; k > j + 1; k--)
+                        tour[k] = tour[k-1];
+                    tour[j + 1] = c;
+                } else {
+                    // Remove from i, insert after j (j > i)
+                    int c = tour[i];
+                    for (int k = i; k < j; k++)
+                        tour[k] = tour[k+1];
+                    tour[j] = c;
+                }
+
+                // Cost of new edges in [lo, hi]
+                double newRegionCost = 0;
+                for (int t = lo; t <= hi; t++)
