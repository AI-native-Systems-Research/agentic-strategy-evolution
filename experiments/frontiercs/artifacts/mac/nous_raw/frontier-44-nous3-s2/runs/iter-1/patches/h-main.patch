+    // Penalty positions: tour indices 9, 19, 29, ... (step 10, 20, 30, ...)
+    // At step t, source city is tour[t-1]. So for step 10, source is tour[9].
+    vector<int> penaltyIndices; // indices in tour where source city matters
+    for (int t = 10; t <= N; t += 10) {
+        penaltyIndices.push_back(t - 1); // tour[t-1] is the source city
+    }
+
+    // For each penalty index, if current city is not prime, try swapping with a nearby prime
+    double postCost = totalCost();
+
+    for (int pi : penaltyIndices) {
