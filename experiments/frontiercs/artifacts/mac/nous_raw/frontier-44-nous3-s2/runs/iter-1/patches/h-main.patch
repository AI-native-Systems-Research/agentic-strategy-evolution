+
+    RNG rng(42);
+
+    // SA parameters
+    double T = curCost / N;
+    double Tmin = 1e-6;
+    double timeLimit = 1.85; // seconds
+
+    // Precompute inverse position: pos[city] = index in tour (1..N-1 for non-zero cities)
