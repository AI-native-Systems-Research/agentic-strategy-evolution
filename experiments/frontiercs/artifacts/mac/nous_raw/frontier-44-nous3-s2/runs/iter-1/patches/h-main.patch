+// Fast XorShift RNG
+struct RNG {
+    uint64_t s;
+    RNG(uint64_t seed = 42) : s(seed) {}
+    uint64_t next() {
+        s ^= s << 13;
+        s ^= s >> 7;
+        s ^= s << 17;
+        return s;
+    }
+    // Returns [0, n)
+    int nextInt(int n) {
+        return next() % n;
+    }
+    // Returns [0.0, 1.0)
+    double nextDouble() {
+        return (next() & 0xFFFFFFFFFFFFF) / (double)(1LL << 52);
+    }
+};
+
+static int N;
+static vector<double> cx, cy;
+static vector<bool> is_prime;
+static vector<int> tour; // tour[0..N], tour[0]=tour[N]=0
+
+inline double dist(int a, int b) {
+    double dx = cx[a] - cx[b];
+    double dy = cy[a] - cy[b];
+    return sqrt(dx*dx + dy*dy);
+}
+
+// Precompute prime sieve
+void sieve(int maxn) {
+    is_prime.assign(maxn + 1, true);
+    is_prime[0] = is_prime[1] = false;
+    for (int i = 2; i * i <= maxn; i++) {
+        if (is_prime[i]) {
+            for (int j = i*i; j <= maxn; j += i)
+                is_prime[j] = false;
+        }
+    }
+}
+
+// Get multiplier for step t (1-indexed): moving from tour[t-1] to tour[t]
+// Step t has penalty if t % 10 == 0 and tour[t-1] is not prime
+inline double multiplier(int t) {
+    if (t % 10 == 0 && !is_prime[tour[t-1]])
+        return 1.1;
+    return 1.0;
+}
+
+// Cost of edge at position t (step t, 1-indexed): tour[t-1] -> tour[t]
+inline double edgeCost(int t) {
+    return multiplier(t) * dist(tour[t-1], tour[t]);
+}
+
+// Compute total tour cost
+double totalCost() {
+    double c = 0;
+    for (int t = 1; t <= N; t++)
+        c += edgeCost(t);
+    return c;
+}
+
+// Nearest-neighbor construction using grid buckets
+void constructNN() {
+    // Grid-based NN
+    int gridSize = max(1, (int)sqrt(N));
+
+    double minx = *min_element(cx.begin(), cx.end());
+    double maxx = *max_element(cx.begin(), cx.end());
+    double miny = *min_element(cy.begin(), cy.end());
+    double maxy = *max_element(cy.begin(), cy.end());
+
+    double cellW = (maxx - minx + 1.0) / gridSize;
+    double cellH = (maxy - miny + 1.0) / gridSize;
+
+    // Assign cities to grid cells
+    vector<vector<int>> grid(gridSize * gridSize);
+    auto getCell = [&](int city) -> int {
+        int gx = min(gridSize - 1, (int)((cx[city] - minx) / cellW));
+        int gy = min(gridSize - 1, (int)((cy[city] - miny) / cellH));
+        return gy * gridSize + gx;
+    };
+
+    for (int i = 0; i < N; i++)
+        grid[getCell(i)].push_back(i);
+
+    vector<bool> visited(N, false);
+    tour.resize(N + 1);
+    tour[0] = 0;
+    visited[0] = true;
+
+    for (int step = 1; step < N; step++) {
+        int cur = tour[step - 1];
+        int gcx_i = min(gridSize - 1, (int)((cx[cur] - minx) / cellW));
+        int gcy_i = min(gridSize - 1, (int)((cy[cur] - miny) / cellH));
+
+        double bestDist = 1e18;
+        int bestCity = -1;
+
+        // Search expanding rings of grid cells
+        for (int ring = 0; ring < gridSize + 1; ring++) {
+            if (bestCity != -1 && ring > 1) {
+                // Check if any city in further rings could be closer
+                double minPossibleDist = max(0.0, (ring - 1.0)) * min(cellW, cellH);
+                if (minPossibleDist > bestDist) break;
+            }
+
+            int x0 = max(0, gcx_i - ring);
+            int x1 = min(gridSize - 1, gcx_i + ring);
+            int y0 = max(0, gcy_i - ring);
+            int y1 = min(gridSize - 1, gcy_i + ring);
+
+            for (int gy = y0; gy <= y1; gy++) {
+                for (int gx = x0; gx <= x1; gx++) {
+                    // Only cells on the ring boundary (or ring 0)
+                    if (ring > 0 && gx > x0 && gx < x1 && gy > y0 && gy < y1)
+                        continue;
+                    int cell = gy * gridSize + gx;
+                    for (int city : grid[cell]) {
+                        if (!visited[city]) {
+                            double d = dist(cur, city);
+                            if (d < bestDist) {
+                                bestDist = d;
+                                bestCity = city;
+                            }
+                        }
+                    }
+                }
+            }
+            if (bestCity != -1 && ring >= 1) break;
+        }
+
+        tour[step] = bestCity;
+        visited[bestCity] = true;
+    }
+    tour[N] = 0;
+}
