+
+                // New cost in region
+                double newRegionCost = 0;
+                for (int t = lo; t <= hi; t++)
+                    newRegionCost += edgeCost(t);
+
+                double delta = newRegionCost - oldRegionCost;
+
+                if (delta < 0 || rng.nextDouble() < exp(-delta / T)) {
