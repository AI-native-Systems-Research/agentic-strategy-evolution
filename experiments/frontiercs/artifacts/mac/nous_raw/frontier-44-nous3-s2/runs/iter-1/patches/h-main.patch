+                // Plus penalty status changes at pi and qi (and neighbors if they're penalty positions)
+
+                int lo = min(pi, qi) - 1;
+                int hi = max(pi, qi) + 1;
+                if (lo < 1) lo = 1;
+                if (hi > N) hi = N;
+
+                double oldCost = 0;
+                for (int t = lo; t <= hi; t++)
+                    oldCost += edgeCost(t);
+
+                swap(tour[pi], tour[qi]);
+
+                double newCost = 0;
+                for (int t = lo; t <= hi; t++)
+                    newCost += edgeCost(t);
+
+                double delta = newCost - oldCost;
+
+                swap(tour[pi], tour[qi]); // undo
+
+                if (delta < bestDelta) {
