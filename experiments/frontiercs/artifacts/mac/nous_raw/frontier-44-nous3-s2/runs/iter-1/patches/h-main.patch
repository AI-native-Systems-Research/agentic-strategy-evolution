--- a/solution.cpp
+++ b/solution.cpp
@@ -1,3 +1,209 @@
 #include <bits/stdc++.h>
 using namespace std;
-int main(){return 0;}
+
+static int N;
+static double *CX, *CY;
+static int *tour;
+static bool *prm;
+
+struct RNG {
+    uint64_t s;
+    RNG(uint64_t seed = 88172645463325252ULL) : s(seed) {}
+    inline uint64_t next() { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return s; }
+    inline uint32_t nextInt(uint32_t n) { return next() % n; }
+    inline double nextDouble() { return (next() & 0xFFFFFFFFFFFFFULL) * (1.0 / (1ULL << 52)); }
+};
+
+void sieve(int maxn) {
+    prm = new bool[maxn + 1];
+    fill(prm, prm + maxn + 1, true);
+    prm[0] = prm[1] = false;
+    for (int i = 2; (long long)i * i <= maxn; i++)
+        if (prm[i])
+            for (int j = i * i; j <= maxn; j += i)
+                prm[j] = false;
+}
+
+inline double ddist(int a, int b) {
+    double dx = CX[a] - CX[b], dy = CY[a] - CY[b];
+    return sqrt(dx * dx + dy * dy);
+}
+
+inline double mult(int t, int src) {
+    return (t % 10 == 0 && !prm[src]) ? 1.1 : 1.0;
+}
+
+inline double ecost(int t) {
+    return mult(t, tour[t - 1]) * ddist(tour[t - 1], tour[t]);
+}
+
+double totalCost() {
+    double c = 0;
+    for (int t = 1; t <= N; t++) c += ecost(t);
+    return c;
+}
+
+void nnConstruct() {
+    double minx = 1e18, maxx = -1e18, miny = 1e18, maxy = -1e18;
+    for (int i = 0; i < N; i++) {
+        minx = min(minx, CX[i]); maxx = max(maxx, CX[i]);
+        miny = min(miny, CY[i]); maxy = max(maxy, CY[i]);
+    }
+    int G = max(1, (int)sqrt((double)N / 4.0));
+    double cw = (maxx - minx + 1.0) / G;
+    double ch = (maxy - miny + 1.0) / G;
+    vector<vector<int>> grid(G * G);
+    for (int i = 0; i < N; i++) {
+        int gx = min(G - 1, (int)((CX[i] - minx) / cw));
+        int gy = min(G - 1, (int)((CY[i] - miny) / ch));
+        grid[gy * G + gx].push_back(i);
+    }
+    vector<bool> used(N, false);
+    tour[0] = 0; used[0] = true;
+    for (int step = 1; step < N; step++) {
+        int cur = tour[step - 1];
+        int gx = min(G - 1, (int)((CX[cur] - minx) / cw));
+        int gy = min(G - 1, (int)((CY[cur] - miny) / ch));
+        int best = -1; double bd = 1e18;
+        for (int ring = 0; ring <= G; ring++) {
+            bool found = false;
+            int lx = max(0, gx - ring), hx = min(G - 1, gx + ring);
+            int ly = max(0, gy - ring), hy = min(G - 1, gy + ring);
+            for (int y2 = ly; y2 <= hy; y2++)
+                for (int x2 = lx; x2 <= hx; x2++) {
+                    if (ring > 0 && x2 > lx && x2 < hx && y2 > ly && y2 < hy) continue;
+                    for (int c : grid[y2 * G + x2]) {
+                        if (used[c]) continue;
+                        double d = (CX[cur]-CX[c])*(CX[cur]-CX[c]) + (CY[cur]-CY[c])*(CY[cur]-CY[c]);
+                        if (d < bd) { bd = d; best = c; found = true; }
+                    }
+                }
+            if (found) break;
+        }
+        tour[step] = best; used[best] = true;
+    }
+    tour[N] = 0;
+}
+
+int main() {
+    ios::sync_with_stdio(false);
+    cin.tie(nullptr);
+
+    auto T0 = chrono::steady_clock::now();
+    auto elapsed = [&]() -> double {
+        return chrono::duration<double>(chrono::steady_clock::now() - T0).count();
+    };
+
+    cin >> N;
+    CX = new double[N]; CY = new double[N];
+    for (int i = 0; i < N; i++) cin >> CX[i] >> CY[i];
+    sieve(N);
+
+    if (N <= 3) {
+        cout << N + 1 << "\n" << 0 << "\n";
+        for (int i = 1; i < N; i++) cout << i << "\n";
+        cout << 0 << "\n";
+        return 0;
+    }
+
+    tour = new int[N + 1];
+    nnConstruct();
+
+    double curCost = totalCost();
+    RNG rng(42);
+
+    // Track best
+    int *bestTour = new int[N + 1];
+    memcpy(bestTour, tour, (N + 1) * sizeof(int));
+    double bestCost = curCost;
+
+    double timeLimit = 1.80;
+
+    // ---- SA: 40% swap (exact) + 60% 2-opt boundary (approx) ----
+    while (elapsed() < timeLimit) {
+        double progress = elapsed() / timeLimit;
+        double temp = (curCost / N) * pow(1e-4, progress);
+
+        for (int batch = 0; batch < 2000; batch++) {
+            if (rng.nextInt(5) < 2) {
+                // Swap (exact delta)
+                int p = 1 + rng.nextInt(N - 1);
+                int q = 1 + rng.nextInt(N - 1);
+                if (p == q) continue;
+                double oldC, newC;
+                if (abs(p - q) == 1) {
+                    int lo = min(p, q), hi = max(p, q);
+                    oldC = ecost(lo) + ecost(hi) + ecost(hi + 1);
+                    swap(tour[lo], tour[hi]);
+                    newC = ecost(lo) + ecost(hi) + ecost(hi + 1);
+                } else {
+                    oldC = ecost(p) + ecost(p + 1) + ecost(q) + ecost(q + 1);
+                    swap(tour[p], tour[q]);
+                    newC = ecost(p) + ecost(p + 1) + ecost(q) + ecost(q + 1);
+                }
+                double delta = newC - oldC;
+                if (delta < 0 || rng.nextDouble() < exp(-delta / temp)) {
+                    curCost += delta;
+                } else {
+                    if (abs(p - q) == 1) swap(tour[min(p,q)], tour[max(p,q)]);
+                    else swap(tour[p], tour[q]);
+                }
+            } else {
+                // 2-opt boundary delta (approximate, fast)
+                int i = 1 + rng.nextInt(N - 1);
+                int len = 2 + rng.nextInt(min(200, N - 2));
+                int j = i + len - 1;
+                if (j >= N) continue;
+
+                double oldD = ddist(tour[i-1], tour[i]) + ddist(tour[j], tour[j+1]);
+                double newD = ddist(tour[i-1], tour[j]) + ddist(tour[i], tour[j+1]);
+                double delta = newD - oldD;
+
+                if (delta < 0 || rng.nextDouble() < exp(-delta / temp)) {
+                    reverse(tour + i, tour + j + 1);
+                    curCost += delta;
+                }
+            }
+        }
+
+        // Periodic recompute + best tracking
+        curCost = totalCost();
+        if (curCost < bestCost) {
+            bestCost = curCost;
+            memcpy(bestTour, tour, (N + 1) * sizeof(int));
+        }
+    }
+
+    memcpy(tour, bestTour, (N + 1) * sizeof(int));
+
+    // ---- Prime scheduling post-pass ----
+    for (int pass = 0; pass < 10 && elapsed() < 1.95; pass++) {
+        bool any = false;
+        for (int t = 10; t <= N; t += 10) {
+            int pp = t - 1;
+            if (pp < 1 || pp >= N) continue;
+            if (prm[tour[pp]]) continue;
+            double bestDelta = 0; int bestSp = -1;
+            for (int trial = 0; trial < 500; trial++) {
+                int sp = 1 + rng.nextInt(N - 1);
+                if (sp == pp || abs(sp - pp) <= 1) continue;
+                if (!prm[tour[sp]]) continue;
+                double oldC = ecost(pp) + ecost(pp + 1) + ecost(sp) + ecost(sp + 1);
+                swap(tour[pp], tour[sp]);
+                double newC = ecost(pp) + ecost(pp + 1) + ecost(sp) + ecost(sp + 1);
+                double delta = newC - oldC;
+                swap(tour[pp], tour[sp]);
+                if (delta < bestDelta) { bestDelta = delta; bestSp = sp; }
+            }
+            if (bestSp >= 0) {
+                swap(tour[pp], tour[bestSp]);
+                any = true;
+            }
+        }
+        if (!any) break;
+    }
+
+    cout << N + 1 << "\n";
+    for (int i = 0; i <= N; i++) cout << tour[i] << "\n";
+    return 0;
+}
