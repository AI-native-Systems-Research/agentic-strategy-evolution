+int main(){
+    ios::sync_with_stdio(false);
+    cin.tie(nullptr);
+
+    auto startTime = chrono::steady_clock::now();
+    auto elapsed = [&]() -> double {
+        return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();
+    };
+
+    cin >> N;
+    cx.resize(N); cy.resize(N);
+    for (int i = 0; i < N; i++)
