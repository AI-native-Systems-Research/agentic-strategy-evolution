 #include <bits/stdc++.h>
 using namespace std;
-int main(){return 0;}
+
+const int MAXN = 1001;
+bitset<MAXN> adj[MAXN];
+int N, M;
+int best[MAXN], bestSz;
+
+void greedy(int* ord, int n) {
+    bitset<MAXN> cs;
+    int cl[MAXN], sz = 0;
+    for (int i = 0; i < n; i++) {
+        int v = ord[i];
+        if ((int)(cs & adj[v]).count() == sz) {
+            cl[sz++] = v;
+            cs.set(v);
+        }
+    }
+    if (sz > bestSz) {
+        bestSz = sz;
+        memcpy(best, cl, sz * sizeof(int));
+    }
+}
+
+int main() {
+    ios::sync_with_stdio(false);
+    cin.tie(nullptr);
+
+    cin >> N >> M;
+    for (int i = 0; i < M; i++) {
+        int u, v; cin >> u >> v; u--; v--;
+        adj[u].set(v); adj[v].set(u);
+    }
+    bestSz = 0;
+
+    // Greedy restarts only — no BnB
+    int ord[MAXN];
+    iota(ord, ord + N, 0);
+
+    // Degree-descending greedy
+    sort(ord, ord + N, [](int a, int b){ return adj[a].count() > adj[b].count(); });
+    greedy(ord, N);
+
+    // Random restarts
+    mt19937 rng(42);
+    for (int r = 0; r < 4999; r++) {
+        shuffle(ord, ord + N, rng);
+        greedy(ord, N);
+    }
+
+    bool inCl[MAXN] = {};
+    for (int i = 0; i < bestSz; i++) inCl[best[i]] = true;
+    for (int i = 0; i < N; i++) cout << inCl[i] << "\n";
+}
