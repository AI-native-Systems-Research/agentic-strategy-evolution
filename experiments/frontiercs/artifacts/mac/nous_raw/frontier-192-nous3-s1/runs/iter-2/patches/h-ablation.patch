@@ -1,3 +1,121 @@
 #include <bits/stdc++.h>
 using namespace std;
-int main(){return 0;}
+
+int main(){
+    ios_base::sync_with_stdio(false);
+    cin.tie(NULL);
+
+    int n, m;
+    cin >> n >> m;
+
+    vector<vector<int>> adj(n+1);
+    for(int i = 0; i < m; i++){
+        int u, v;
+        cin >> u >> v;
+        adj[u].push_back(v);
+        adj[v].push_back(u);
+    }
+
+    if(m == 0){
+        for(int i = 1; i <= n; i++){
+            if(i > 1) cout << ' ';
+            cout << 0;
+        }
+        cout << '\n';
+        return 0;
+    }
+
+    mt19937 rng(chrono::steady_clock::now().time_since_epoch().count());
+
+    vector<int> bestPart(n+1, 0);
+    int bestCut = -1;
+
+    auto calcGain = [&](vector<int>& part, int u) -> int {
+        int gain = 0;
+        for(int v : adj[u]){
+            if(part[u] == part[v]) gain++;
+            else gain--;
+        }
+        return gain;
+    };
+
+    auto greedyLS = [&](vector<int>& part) -> int {
+        bool improved = true;
+        while(improved){
+            improved = false;
+            for(int u = 1; u <= n; u++){
+                int g = calcGain(part, u);
+                if(g > 0){
+                    part[u] ^= 1;
+                    improved = true;
+                }
+            }
+        }
+        int cut = 0;
+        for(int u = 1; u <= n; u++)
+            for(int v : adj[u])
+                if(part[u] != part[v]) cut++;
+        return cut / 2;
+    };
+
+    auto startTime = chrono::steady_clock::now();
+    auto elapsed = [&]() -> double {
+        return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();
+    };
+
+    double timeLimit = 0.90;
+    double T = 2.0;
+    double cooling = 0.9995;
+    int iterCap = 200000;
+
+    while(elapsed() < timeLimit){
+        // Random initialization
+        vector<int> part(n+1);
+        for(int i = 1; i <= n; i++){
+            part[i] = rng() & 1;
+        }
+
+        // Greedy to local optimum
+        int cut = greedyLS(part);
+
+        // SA with geometric cooling
+        double temp = T;
+        for(int iter = 0; iter < iterCap; iter++){
+            if(elapsed() >= timeLimit) break;
+
+            int u = (rng() % n) + 1;
+            int g = calcGain(part, u);
+
+            if(g > 0){
+                part[u] ^= 1;
+                cut += g;
+            } else if(g == 0){
+                if(rng() & 1){
+                    part[u] ^= 1;
+                }
+            } else {
+                double prob = exp((double)g / temp);
+                double r = (double)(rng() % 10000) / 10000.0;
+                if(r < prob){
+                    part[u] ^= 1;
+                    cut += g;
+                }
+            }
+
+            temp *= cooling;
+        }
+
+        if(cut > bestCut){
+            bestCut = cut;
+            bestPart = part;
+        }
+    }
+
+    for(int i = 1; i <= n; i++){
+        if(i > 1) cout << ' ';
+        cout << bestPart[i];
+    }
+    cout << '\n';
+
+    return 0;
+}
