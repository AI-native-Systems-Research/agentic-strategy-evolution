 #include <bits/stdc++.h>
 using namespace std;
-int main(){return 0;}
+
+static const int MAXN = 1001;
+bitset<MAXN> adj[MAXN];
+int N, M;
+int best_size;
+vector<int> best_clique;
+vector<int> cur_clique;
+
+// Greedy coloring on candidates; returns number of colors and fills color_classes
+int greedy_color(const vector<int>& cand, vector<vector<int>>& cc) {
+    cc.clear();
+    int nc = 0;
+    // color[v] = assigned color (1-indexed), 0 = uncolored
+    static int col[MAXN];
+    for (int v : cand) col[v] = 0;
+
+    for (int v : cand) {
+        // Find smallest color not used by neighbors in cand
+        bitset<MAXN> nb; // colors used by neighbors
+        for (int u : cand) {
+            if (col[u] > 0 && adj[v][u]) {
+                if (col[u] < MAXN) nb.set(col[u]);
+            }
+        }
+        int c = 1;
+        while (nb[c]) c++;
+        col[v] = c;
+        if (c > nc) {
+            nc = c;
+            cc.resize(nc);
+        }
+        cc[c - 1].push_back(v);
+    }
+    return nc;
+}
+
+void expand(vector<int>& cand) {
+    if (cand.empty()) {
+        if ((int)cur_clique.size() > best_size) {
+            best_size = cur_clique.size();
+            best_clique = cur_clique;
+        }
+        return;
+    }
+
+    vector<vector<int>> cc;
+    int nc = greedy_color(cand, cc);
+
+    if ((int)cur_clique.size() + nc <= best_size) return;
+
+    // Branch from highest color class down
+    for (int i = nc - 1; i >= 0; i--) {
+        if ((int)cur_clique.size() + i + 1 <= best_size) return;
+        for (int v : cc[i]) {
+            vector<int> new_cand;
+            new_cand.reserve(cand.size());
+            for (int u : cand) {
+                if (adj[v][u]) new_cand.push_back(u);
+            }
+            cur_clique.push_back(v);
+            expand(new_cand);
+            cur_clique.pop_back();
+        }
+    }
+}
+
+int main(){
+    ios::sync_with_stdio(false);
+    cin.tie(nullptr);
+
+    cin >> N >> M;
+    for (int i = 0; i < M; i++) {
+        int u, v;
+        cin >> u >> v;
+        adj[u].set(v);
+        adj[v].set(u);
+    }
+
+    // Compute degree for each vertex
+    vector<int> degree(N + 1, 0);
+    for (int i = 1; i <= N; i++) {
+        for (int j = 1; j <= N; j++) {
+            if (adj[i][j]) degree[i]++;
+        }
+    }
+
+    // Degeneracy ordering
+    vector<int> dorder;
+    vector<bool> removed(N + 1, false);
+    vector<int> ddeg(degree.begin(), degree.end());
+    for (int iter = 0; iter < N; iter++) {
+        int mv = -1, md = N + 1;
+        for (int i = 1; i <= N; i++) {
+            if (!removed[i] && ddeg[i] < md) {
+                md = ddeg[i];
+                mv = i;
+            }
+        }
+        removed[mv] = true;
+        dorder.push_back(mv);
+        for (int j = 1; j <= N; j++) {
+            if (!removed[j] && adj[mv][j]) ddeg[j]--;
+        }
+    }
+    reverse(dorder.begin(), dorder.end());
+
+    // Greedy warm start: sort by degree descending, greedily add
+    {
+        vector<int> sv;
+        for (int i = 1; i <= N; i++) sv.push_back(i);
+        sort(sv.begin(), sv.end(), [&](int a, int b){ return degree[a] > degree[b]; });
+        vector<int> gc;
+        for (int v : sv) {
+            bool ok = true;
+            for (int u : gc) {
+                if (!adj[v][u]) { ok = false; break; }
+            }
+            if (ok) gc.push_back(v);
+        }
+        best_size = gc.size();
+        best_clique = gc;
+    }
+
+    // Main BnB
+    for (int idx = 0; idx < N; idx++) {
+        int v = dorder[idx];
+        vector<int> cand;
+        for (int j = idx + 1; j < N; j++) {
+            if (adj[v][dorder[j]]) cand.push_back(dorder[j]);
+        }
+        cur_clique.clear();
+        cur_clique.push_back(v);
+        if ((int)cand.size() + 1 > best_size) {
+            expand(cand);
+        }
+    }
+
+    // Output
+    vector<bool> inc(N + 1, false);
+    for (int v : best_clique) inc[v] = true;
+    for (int i = 1; i <= N; i++) {
+        cout << (inc[i] ? 1 : 0) << "\n";
+    }
+    return 0;
+}
