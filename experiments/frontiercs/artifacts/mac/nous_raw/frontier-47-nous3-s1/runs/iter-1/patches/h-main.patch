+struct Rect { int x, y, w, h; };
+
+struct ItemType {
+    string type;
+    int w, h, v, limit;
+    double density; // v / (w*h)
+};
+
+struct Placement {
+    string type;
+    int x, y, rot;
+};
+
+// ---- MaxRects Bin ----
+struct MaxRectsBin {
+    int W, H;
+    vector<Rect> freeRects;
+
+    void init(int w, int h) {
+        W = w; H = h;
+        freeRects.clear();
+        freeRects.push_back({0, 0, W, H});
+    }
+
+    // method: 0=BSSF, 1=BAF, 2=BL
+    Rect findBest(int w, int h, int method, int &bestScore1, int &bestScore2) {
+        bestScore1 = INT_MAX;
+        bestScore2 = INT_MAX;
+        Rect best = {-1, -1, 0, 0};
+        for (auto &r : freeRects) {
+            if (w <= r.w && h <= r.h) {
+                int s1, s2;
+                if (method == 0) { // BSSF
+                    s1 = min(r.w - w, r.h - h);
+                    s2 = max(r.w - w, r.h - h);
+                } else if (method == 1) { // BAF
+                    s1 = r.w * r.h - w * h;
+                    s2 = min(r.w - w, r.h - h);
+                } else { // BL
+                    s1 = r.y;
+                    s2 = r.x;
+                }
+                if (s1 < bestScore1 || (s1 == bestScore1 && s2 < bestScore2)) {
+                    bestScore1 = s1;
+                    bestScore2 = s2;
+                    best = {r.x, r.y, w, h};
+                }
+            }
+        }
+        return best;
+    }
+
+    void placeRect(Rect placed) {
+        vector<Rect> newFree;
+        for (auto &r : freeRects) {
+            // Check overlap
+            if (placed.x >= r.x + r.w || placed.x + placed.w <= r.x ||
+                placed.y >= r.y + r.h || placed.y + placed.h <= r.y) {
+                newFree.push_back(r);
+                continue;
+            }
+            // Split
+            if (placed.x > r.x)
+                newFree.push_back({r.x, r.y, placed.x - r.x, r.h});
+            if (placed.x + placed.w < r.x + r.w)
+                newFree.push_back({placed.x + placed.w, r.y, r.x + r.w - placed.x - placed.w, r.h});
+            if (placed.y > r.y)
+                newFree.push_back({r.x, r.y, r.w, placed.y - r.y});
+            if (placed.y + placed.h < r.y + r.h)
+                newFree.push_back({r.x, placed.y + placed.h, r.w, r.y + r.h - placed.y - placed.h});
+        }
+        freeRects = newFree;
+        pruneFreeRects();
+    }
+
+    void pruneFreeRects() {
+        for (int i = (int)freeRects.size() - 1; i >= 0; i--) {
+            for (int j = (int)freeRects.size() - 1; j >= 0; j--) {
+                if (i == j) continue;
+                auto &a = freeRects[i], &b = freeRects[j];
+                if (a.x >= b.x && a.y >= b.y &&
+                    a.x + a.w <= b.x + b.w && a.y + a.h <= b.y + b.h) {
+                    freeRects.erase(freeRects.begin() + i);
+                    break;
+                }
+            }
+        }
+    }
+};
+
+// ---- Skyline Bin ----
+struct SkylineBin {
+    int W, H;
+    struct Segment { int x, y, w; };
+    vector<Segment> skyline;
+
+    void init(int w, int h) {
+        W = w; H = h;
+        skyline.clear();
+        skyline.push_back({0, 0, W});
+    }
+
+    // Bottom-left, find best position for (w, h)
+    bool findPosition(int w, int h, int &bestX, int &bestY, int &bestIdx) {
+        bestY = INT_MAX;
+        bestX = INT_MAX;
+        bestIdx = -1;
+        for (int i = 0; i < (int)skyline.size(); i++) {
+            int x = skyline[i].x;
+            if (x + w > W) continue;
+            int y = 0;
+            int widthLeft = w;
+            bool fits = true;
+            for (int j = i; j < (int)skyline.size() && widthLeft > 0; j++) {
+                y = max(y, skyline[j].y);
+                if (y + h > H) { fits = false; break; }
+                widthLeft -= skyline[j].w;
+                if (j == i) widthLeft += (x - skyline[j].x);
+            }
+            if (!fits || widthLeft > 0) continue;
+            if (y < bestY || (y == bestY && x < bestX)) {
+                bestY = y;
+                bestX = x;
+                bestIdx = i;
+            }
+        }
+        return bestIdx != -1;
+    }
+
+    void addSkylineLevel(int x, int y, int w, int h) {
+        Segment s = {x, y + h, w};
+        // Remove covered segments
+        vector<Segment> newSky;
+        bool inserted = false;
+        for (auto &seg : skyline) {
+            if (seg.x + seg.w <= x || seg.x >= x + w) {
+                newSky.push_back(seg);
+            } else {
+                if (!inserted) {
+                    newSky.push_back(s);
+                    inserted = true;
+                }
+                // Trim left part
+                if (seg.x < x) {
+                    newSky.insert(newSky.end() - (inserted ? 1 : 0), {seg.x, seg.y, x - seg.x});
+                }
+                // Trim right part
+                if (seg.x + seg.w > x + w) {
+                    newSky.push_back({x + w, seg.y, seg.x + seg.w - x - w});
+                }
+            }
+        }
+        if (!inserted) newSky.push_back(s);
+        skyline = newSky;
+        // Merge adjacent same-height
+        vector<Segment> merged;
+        for (auto &seg : skyline) {
+            if (!merged.empty() && merged.back().y == seg.y &&
+                merged.back().x + merged.back().w == seg.x) {
+                merged.back().w += seg.w;
+            } else {
+                merged.push_back(seg);
+            }
+        }
+        skyline = merged;
+    }
+};
