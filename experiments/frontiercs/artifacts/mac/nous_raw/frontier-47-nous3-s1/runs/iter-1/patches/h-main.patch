+// ---- JSON parsing helpers ----
+int parseInt(const string &s, size_t &pos) {
+    while (pos < s.size() && (s[pos] == ' ' || s[pos] == '\t' || s[pos] == '\n' || s[pos] == '\r')) pos++;
+    bool neg = false;
+    if (pos < s.size() && s[pos] == '-') { neg = true; pos++; }
+    long long val = 0;
+    while (pos < s.size() && s[pos] >= '0' && s[pos] <= '9') {
+        val = val * 10 + (s[pos] - '0');
+        pos++;
+    }
+    return neg ? -(int)val : (int)val;
+}
+
+string parseString(const string &s, size_t &pos) {
+    while (pos < s.size() && s[pos] != '"') pos++;
+    pos++; // skip opening "
+    string result;
+    while (pos < s.size() && s[pos] != '"') {
+        result += s[pos++];
+    }
+    pos++; // skip closing "
+    return result;
+}
+
+bool parseBool(const string &s, size_t &pos) {
+    while (pos < s.size() && (s[pos] == ' ' || s[pos] == '\t' || s[pos] == '\n' || s[pos] == '\r')) pos++;
+    if (pos < s.size() && s[pos] == 't') { pos += 4; return true; }
+    pos += 5; return false;
+}
+
+void skipTo(const string &s, size_t &pos, char c) {
+    while (pos < s.size() && s[pos] != c) pos++;
+}
+
+int main() {
+    auto startTime = chrono::steady_clock::now();
+
+    // Read all input
+    string input;
+    {
+        ostringstream ss;
+        ss << cin.rdbuf();
+        input = ss.str();
+    }
+
+    // Parse bin
+    int W, H;
+    bool allowRotate = false;
+    {
+        size_t p = input.find("\"W\"");
+        p += 3;
+        skipTo(input, p, ':'); p++;
+        W = parseInt(input, p);
+
+        p = input.find("\"H\"");
+        p += 3;
+        skipTo(input, p, ':'); p++;
+        H = parseInt(input, p);
+
+        p = input.find("\"allow_rotate\"");
+        p += 14;
+        skipTo(input, p, ':'); p++;
+        allowRotate = parseBool(input, p);
+    }
+
+    // Parse items
+    vector<ItemType> items;
+    {
+        size_t p = input.find("\"items\"");
+        p += 7;
+        skipTo(input, p, '['); p++;
+
+        while (p < input.size()) {
+            skipTo(input, p, '{');
+            if (p >= input.size()) break;
+            p++;
+
+            ItemType it;
+            it.w = 0; it.h = 0; it.v = 0; it.limit = 0;
+
+            // Parse 5 key-value pairs
+            for (int k = 0; k < 5; k++) {
+                string key = parseString(input, p);
+                skipTo(input, p, ':'); p++;
+                if (key == "type") {
+                    it.type = parseString(input, p);
+                } else if (key == "w") {
+                    it.w = parseInt(input, p);
+                } else if (key == "h") {
+                    it.h = parseInt(input, p);
+                } else if (key == "v") {
+                    it.v = parseInt(input, p);
+                } else if (key == "limit") {
+                    it.limit = parseInt(input, p);
+                }
+                // skip comma
+                while (p < input.size() && (input[p] == ',' || input[p] == ' ' || input[p] == '\n' || input[p] == '\r' || input[p] == '\t')) p++;
+                if (p < input.size() && input[p] == '}') break;
+            }
+            it.density = (double)it.v / ((double)it.w * it.h);
+            items.push_back(it);
+
+            skipTo(input, p, '}'); p++;
+            // Check for ] (end of array)
+            size_t q = p;
+            while (q < input.size() && (input[q] == ',' || input[q] == ' ' || input[q] == '\n' || input[q] == '\r' || input[q] == '\t')) q++;
+            if (q >= input.size() || input[q] == ']') break;
+            p = q;
+        }
+    }
+
+    int M = items.size();
+
+    // ---- Greedy MaxRects packing ----
+    // Returns total profit and placements
+    auto greedyMaxRects = [&](const vector<int> &order, int method, bool tryRotate) -> pair<long long, vector<Placement>> {
+        MaxRectsBin bin;
+        bin.init(W, H);
+        vector<Placement> placements;
+        long long profit = 0;
+        vector<int> used(M, 0);
+
+        for (int idx : order) {
+            auto &it = items[idx];
+            while (used[idx] < it.limit) {
+                int s1, s2;
+                Rect r = bin.findBest(it.w, it.h, method, s1, s2);
+                int rot = 0;
+                if (r.x == -1 && tryRotate && allowRotate && it.w != it.h) {
+                    r = bin.findBest(it.h, it.w, method, s1, s2);
+                    rot = 1;
+                }
+                if (r.x == -1) break;
+                bin.placeRect(r);
+                placements.push_back({it.type, r.x, r.y, rot});
+                profit += it.v;
+                used[idx]++;
+            }
+        }
+        return {profit, placements};
+    };
+
+    // ---- Greedy Skyline packing ----
+    auto greedySkyline = [&](const vector<int> &order, bool tryRotate) -> pair<long long, vector<Placement>> {
+        SkylineBin bin;
+        bin.init(W, H);
+        vector<Placement> placements;
+        long long profit = 0;
+        vector<int> used(M, 0);
+
+        for (int idx : order) {
+            auto &it = items[idx];
+            while (used[idx] < it.limit) {
+                int bx, by, bi;
+                bool found = bin.findPosition(it.w, it.h, bx, by, bi);
+                int rot = 0;
+                if (!found && tryRotate && allowRotate && it.w != it.h) {
+                    found = bin.findPosition(it.h, it.w, bx, by, bi);
+                    rot = 1;
+                }
+                if (!found) break;
+                int pw = rot ? it.h : it.w;
+                int ph = rot ? it.w : it.h;
+                bin.addSkylineLevel(bx, by, pw, ph);
+                placements.push_back({it.type, bx, by, rot});
+                profit += it.v;
+                used[idx]++;
+            }
+        }
+        return {profit, placements};
+    };
+
+    long long bestProfit = -1;
+    vector<Placement> bestPlacements;
+
+    auto tryResult = [&](pair<long long, vector<Placement>> &res) {
+        if (res.first > bestProfit) {
+            bestProfit = res.first;
+            bestPlacements = res.second;
+        }
+    };
+
+    // Generate orderings
+    // 0: density desc, 1: value desc, 2: area desc, 3: max-dim desc, 4: total-value desc, 5: perimeter desc
+    vector<vector<int>> orderings(6, vector<int>(M));
+    for (int i = 0; i < M; i++) for (int j = 0; j < 6; j++) orderings[j][i] = i;
+
+    sort(orderings[0].begin(), orderings[0].end(), [&](int a, int b) {
+        return items[a].density > items[b].density;
+    });
+    sort(orderings[1].begin(), orderings[1].end(), [&](int a, int b) {
+        return items[a].v > items[b].v;
+    });
+    sort(orderings[2].begin(), orderings[2].end(), [&](int a, int b) {
+        return items[a].w * items[a].h > items[b].w * items[b].h;
+    });
+    sort(orderings[3].begin(), orderings[3].end(), [&](int a, int b) {
+        return max(items[a].w, items[a].h) > max(items[b].w, items[b].h);
+    });
+    sort(orderings[4].begin(), orderings[4].end(), [&](int a, int b) {
+        return (long long)items[a].v * items[a].limit > (long long)items[b].v * items[b].limit;
+    });
+    sort(orderings[5].begin(), orderings[5].end(), [&](int a, int b) {
+        return 2*(items[a].w + items[a].h) > 2*(items[b].w + items[b].h);
+    });
+
+    // Run deterministic orderings × 3 MaxRects methods
+    for (int o = 0; o < 6; o++) {
+        for (int m = 0; m < 3; m++) {
+            auto res = greedyMaxRects(orderings[o], m, true);
+            tryResult(res);
+        }
+    }
+
+    // Run Skyline with each ordering
+    for (int o = 0; o < 6; o++) {
+        auto res = greedySkyline(orderings[o], true);
+        tryResult(res);
+    }
+
+    // Randomized search
+    mt19937 rng(12345);
+    uniform_real_distribution<double> dist(0.1, 10.0);
+
+    auto elapsed = [&]() -> double {
+        auto now = chrono::steady_clock::now();
+        return chrono::duration<double>(now - startTime).count();
+    };
+
+    while (elapsed() < 0.75) {
+        // Create a random ordering based on density * noise
+        vector<pair<double, int>> scored(M);
+        for (int i = 0; i < M; i++) {
+            scored[i] = {items[i].density * dist(rng), i};
+        }
+        sort(scored.begin(), scored.end(), [](auto &a, auto &b) { return a.first > b.first; });
+        vector<int> order(M);
+        for (int i = 0; i < M; i++) order[i] = scored[i].second;
+
+        int method = rng() % 3;
+        auto res = greedyMaxRects(order, method, true);
+        tryResult(res);
+    }
+
+    // Output
+    printf("{\"placements\":[");
+    for (int i = 0; i < (int)bestPlacements.size(); i++) {
+        if (i > 0) printf(",");
+        printf("{\"type\":\"%s\",\"x\":%d,\"y\":%d,\"rot\":%d}",
+               bestPlacements[i].type.c_str(),
+               bestPlacements[i].x, bestPlacements[i].y,
+               bestPlacements[i].rot);
+    }
+    printf("]}");
+
+    return 0;
+}
