+int main() {
+    auto startTime = chrono::steady_clock::now();
+    auto elapsed = [&]() -> double {
+        return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();
+    };
+
+    // Parse JSON input
+    string input;
+    {
+        ostringstream ss;
+        ss << cin.rdbuf();
+        input = ss.str();
+    }
+
+    // Simple JSON parser for our specific format
+    auto findInt = [&](const string &s, const string &key, int pos) -> pair<int,int> {
+        string k = "\"" + key + "\"";
+        size_t p = s.find(k, pos);
+        if (p == string::npos) return {-1, -1};
+        p = s.find(':', p);
+        // skip whitespace
+        p++;
+        while (p < s.size() && (s[p] == ' ' || s[p] == '\t' || s[p] == '\n' || s[p] == '\r')) p++;
+        // Read integer or bool
+        int sign = 1;
+        if (s[p] == '-') { sign = -1; p++; }
+        if (s[p] == 't') return {1, (int)(p+4)}; // true
+        if (s[p] == 'f') return {0, (int)(p+5)}; // false
+        long long val = 0;
+        while (p < s.size() && s[p] >= '0' && s[p] <= '9') {
+            val = val * 10 + (s[p] - '0');
+            p++;
+        }
+        return {(int)(sign * val), (int)p};
+    };
+
+    auto findLongLong = [&](const string &s, const string &key, int pos) -> pair<long long, int> {
+        string k = "\"" + key + "\"";
+        size_t p = s.find(k, pos);
+        if (p == string::npos) return {-1, -1};
+        p = s.find(':', p);
+        p++;
+        while (p < s.size() && (s[p] == ' ' || s[p] == '\t' || s[p] == '\n' || s[p] == '\r')) p++;
+        int sign = 1;
+        if (s[p] == '-') { sign = -1; p++; }
+        long long val = 0;
+        while (p < s.size() && s[p] >= '0' && s[p] <= '9') {
+            val = val * 10 + (s[p] - '0');
+            p++;
+        }
+        return {sign * val, (int)p};
+    };
+
+    auto findStr = [&](const string &s, const string &key, int pos) -> pair<string,int> {
+        string k = "\"" + key + "\"";
+        size_t p = s.find(k, pos);
+        if (p == string::npos) return {"", -1};
+        p = s.find(':', p);
+        p++;
+        while (p < s.size() && s[p] != '"') p++;
+        p++; // skip opening quote
+        string val;
+        while (p < s.size() && s[p] != '"') { val += s[p]; p++; }
+        return {val, (int)(p+1)};
+    };
+
+    auto findBool = [&](const string &s, const string &key, int pos) -> pair<bool,int> {
+        string k = "\"" + key + "\"";
+        size_t p = s.find(k, pos);
+        if (p == string::npos) return {false, -1};
+        p = s.find(':', p);
+        p++;
+        while (p < s.size() && (s[p] == ' ' || s[p] == '\t' || s[p] == '\n' || s[p] == '\r')) p++;
+        if (s[p] == 't') return {true, (int)(p+4)};
+        return {false, (int)(p+5)};
+    };
+
+    // Parse bin
+    {
+        size_t binPos = input.find("\"bin\"");
+        auto [w, _1] = findInt(input, "W", binPos);
+        auto [h, _2] = findInt(input, "H", binPos);
+        auto [rot, _3] = findBool(input, "allow_rotate", binPos);
+        binW = w; binH = h; allowRotate = rot;
+    }
+
+    // Parse items
+    {
+        size_t itemsPos = input.find("\"items\"");
+        size_t arrStart = input.find('[', itemsPos);
+        size_t arrEnd = input.rfind(']');
+        // Find each object
+        size_t pos = arrStart;
+        while (true) {
+            size_t objStart = input.find('{', pos);
+            if (objStart == string::npos || objStart > arrEnd) break;
+            size_t objEnd = input.find('}', objStart);
+
+            string obj = input.substr(objStart, objEnd - objStart + 1);
+            ItemType it;
+            auto [tp, _1] = findStr(obj, "type", 0);
+            auto [w, _2] = findInt(obj, "w", 0);
+            auto [h, _3] = findInt(obj, "h", 0);
+            auto [v, _4] = findLongLong(obj, "v", 0);
+            auto [lim, _5] = findInt(obj, "limit", 0);
+            it.type = tp;
+            it.w = w; it.h = h; it.v = (int)v; it.limit = lim;
+            it.density = (double)v / ((double)w * h);
+            items.push_back(it);
+            pos = objEnd + 1;
+        }
+    }
+
+    int M = items.size();
+    long long bestProfit = 0;
+    vector<Placement> bestPlacements;
+
+    auto updateBest = [&](pair<long long, vector<Placement>> &res) {
+        if (res.first > bestProfit) {
+            bestProfit = res.first;
+            bestPlacements = res.second;
+        }
+    };
+
+    // Strategy 1: Sorted orderings with all 3 heuristics
+    // Sorting strategies
+    vector<vector<int>> sortOrders;
+    {
+        // By density desc
+        vector<int> o(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) { return items[a].density > items[b].density; });
+        sortOrders.push_back(o);
+
+        // By value desc
+        o.resize(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) { return items[a].v > items[b].v; });
+        sortOrders.push_back(o);
+
+        // By area desc
+        o.resize(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) { return items[a].w * items[a].h > items[b].w * items[b].h; });
+        sortOrders.push_back(o);
+
+        // By area asc
+        o.resize(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) { return items[a].w * items[a].h < items[b].w * items[b].h; });
+        sortOrders.push_back(o);
+
+        // By height desc
+        o.resize(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) { return items[a].h > items[b].h; });
+        sortOrders.push_back(o);
+
+        // By width desc
+        o.resize(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) { return items[a].w > items[b].w; });
+        sortOrders.push_back(o);
+
+        // By max(w,h) desc
+        o.resize(M); iota(o.begin(), o.end(), 0);
+        sort(o.begin(), o.end(), [](int a, int b) {
+            return max(items[a].w, items[a].h) > max(items[b].w, items[b].h);
+        });
+        sortOrders.push_back(o);
+    }
+
+    for (auto &ord : sortOrders) {
+        vector<pair<int,int>> order;
+        for (int idx : ord) order.push_back({idx, 0});
+        for (int h = 0; h < 3; h++) {
+            auto res = packOrdered(order, h);
+            updateBest(res);
+        }
+    }
+
+    // Strategy 2: Global greedy (4 modes × 3 heuristics)
+    for (int mode = 0; mode < 4; mode++) {
+        for (int h = 0; h < 3; h++) {
+            auto res = packGreedy(h, mode);
+            updateBest(res);
+        }
+    }
+
+    // Strategy 3: Multi-pass (3 heuristics)
+    for (int h = 0; h < 3; h++) {
+        auto res = packMultiPass(h);
+        updateBest(res);
+    }
+
+    // Strategy 4: Permutation exhaustion for small M
+    if (M <= 10 && elapsed() < 0.75) {
+        vector<int> perm(M);
+        iota(perm.begin(), perm.end(), 0);
+        int permCount = 0;
+        int maxPerms = 20000; // safety cap
+
+        do {
+            if (elapsed() > 0.88) break;
+            if (++permCount > maxPerms && M > 8) break;
+
+            vector<pair<int,int>> order;
+            for (int idx : perm) order.push_back({idx, 0});
+            for (int h = 0; h < 3; h++) {
+                auto res = packOrdered(order, h);
+                updateBest(res);
+            }
+        } while (next_permutation(perm.begin(), perm.end()));
+    }
+
+    // Strategy 5: Random shuffle search for remaining time
+    {
+        mt19937 rng(42);
+        vector<int> perm(M);
+        iota(perm.begin(), perm.end(), 0);
+        while (elapsed() < 0.88) {
+            shuffle(perm.begin(), perm.end(), rng);
+            vector<pair<int,int>> order;
+            for (int idx : perm) order.push_back({idx, 0});
+            for (int h = 0; h < 3; h++) {
+                auto res = packOrdered(order, h);
+                updateBest(res);
+            }
+        }
+    }
+
+    // Output JSON
+    printf("{\"placements\":[");
+    for (int i = 0; i < (int)bestPlacements.size(); i++) {
+        if (i > 0) printf(",");
+        printf("{\"type\":\"%s\",\"x\":%d,\"y\":%d,\"rot\":%d}",
+               bestPlacements[i].type.c_str(),
+               bestPlacements[i].x,
+               bestPlacements[i].y,
+               bestPlacements[i].rot);
+    }
+    printf("]}\n");
+
+    return 0;
+}
