+
+chrono::steady_clock::time_point startTime;
+double elapsed() {
+    return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();
+}
+
+struct MaxRectsPacker {
+    vector<Rect> freeRects;
+    void init() { freeRects.clear(); freeRects.push_back({0, 0, binW, binH}); }
+
+    Rect findPosition(int rw, int rh, int heuristic, int &bs1, int &bs2) {
+        Rect best = {-1,-1,rw,rh};
+        bs1 = bs2 = INT_MAX;
+        for (auto &fr : freeRects) {
+            if (rw > fr.w || rh > fr.h) continue;
+            int s1, s2;
+            switch(heuristic) {
+                case 0: s1=min(fr.w-rw,fr.h-rh); s2=max(fr.w-rw,fr.h-rh); break;
+                case 1: s1=fr.w*fr.h-rw*rh; s2=min(fr.w-rw,fr.h-rh); break;
+                case 2: s1=fr.y; s2=fr.x; break;
+                case 3: s1=max(fr.w-rw,fr.h-rh); s2=min(fr.w-rw,fr.h-rh); break;
+                default: s1=s2=INT_MAX;
+            }
+            if (s1<bs1||(s1==bs1&&s2<bs2)) { bs1=s1; bs2=s2; best={fr.x,fr.y,rw,rh}; }
+        }
+        return best;
+    }
+
+    Rect findBestPos(int idx, int h, int &outRot) {
+        auto &it = items[idx];
+        int s1a=INT_MAX,s2a=INT_MAX,s1b=INT_MAX,s2b=INT_MAX;
+        Rect ra = findPosition(it.w, it.h, h, s1a, s2a);
+        Rect rb = {-1,-1,0,0};
+        if (allowRotate && it.w!=it.h)
+            rb = findPosition(it.h, it.w, h, s1b, s2b);
+        if (ra.x>=0 && (rb.x<0 || s1a<s1b || (s1a==s1b && s2a<=s2b))) { outRot=0; return ra; }
+        if (rb.x>=0) { outRot=1; return rb; }
+        outRot=0; return {-1,-1,0,0};
+    }
+
+    void placeRect(Rect placed) {
+        int n = freeRects.size();
+        for (int i = n-1; i >= 0; i--) {
+            auto &fr = freeRects[i];
+            if (placed.x>=fr.x+fr.w||placed.x+placed.w<=fr.x||
+                placed.y>=fr.y+fr.h||placed.y+placed.h<=fr.y) continue;
+            Rect o = fr;
+            freeRects[i] = freeRects.back(); freeRects.pop_back();
+            if (placed.x > o.x) freeRects.push_back({o.x, o.y, placed.x-o.x, o.h});
+            if (placed.x+placed.w < o.x+o.w) freeRects.push_back({placed.x+placed.w, o.y, o.x+o.w-placed.x-placed.w, o.h});
+            if (placed.y > o.y) freeRects.push_back({o.x, o.y, o.w, placed.y-o.y});
+            if (placed.y+placed.h < o.y+o.h) freeRects.push_back({o.x, placed.y+placed.h, o.w, o.y+o.h-placed.y-placed.h});
+        }
+        n = freeRects.size();
+        for (int i = 0; i < n; i++) {
+            for (int j = i+1; j < n; ) {
+                auto &a=freeRects[i], &b=freeRects[j];
+                bool ab = a.x<=b.x && a.y<=b.y && a.x+a.w>=b.x+b.w && a.y+a.h>=b.y+b.h;
+                bool ba = b.x<=a.x && b.y<=a.y && b.x+b.w>=a.x+a.w && b.y+b.h>=a.y+a.h;
+                if (ab) { freeRects[j]=freeRects[--n]; freeRects.resize(n); }
+                else if (ba) { freeRects[i]=freeRects[--n]; freeRects.resize(n); j=i+1; }
+                else j++;
+            }
+        }
+    }
+};
+
+// Pack with ordering, returning packer state for gap filling
+long long packOrderedWithState(const vector<int> &order, int heur, MaxRectsPacker &pk, vector<Placement> &pl, vector<int> &used) {
+    pk.init();
+    long long profit = 0;
+    pl.clear();
+    fill(used.begin(), used.end(), 0);
+    for (int idx : order) {
+        auto &it = items[idx];
+        while (used[idx] < it.limit) {
+            int rot; Rect r = pk.findBestPos(idx, heur, rot);
+            if (r.x < 0) break;
+            pk.placeRect(r);
+            pl.push_back({it.type, r.x, r.y, rot});
+            profit += it.v; used[idx]++;
+        }
+    }
+    return profit;
+}
+
+// Gap filling: try to place remaining item copies into free rectangles
+long long gapFill(MaxRectsPacker &pk, vector<Placement> &pl, vector<int> &used, int heur) {
+    long long extraProfit = 0;
+    // Sort item indices by value density descending
+    vector<int> densOrder(M);
+    iota(densOrder.begin(), densOrder.end(), 0);
+    sort(densOrder.begin(), densOrder.end(), [](int a, int b) {
+        return items[a].density > items[b].density;
+    });
+
+    bool placed = true;
+    while (placed) {
+        placed = false;
+        for (int idx : densOrder) {
+            if (used[idx] >= items[idx].limit) continue;
+            int rot;
+            Rect r = pk.findBestPos(idx, heur, rot);
+            if (r.x < 0) continue;
+            pk.placeRect(r);
+            pl.push_back({items[idx].type, r.x, r.y, rot});
+            extraProfit += items[idx].v;
+            used[idx]++;
+            placed = true;
+        }
+    }
+    return extraProfit;
+}
+
+long long packOrderedFull(const vector<int> &order, int heur, bool doGapFill = true) {
+    MaxRectsPacker pk;
+    vector<Placement> pl;
+    vector<int> used(M, 0);
+    long long profit = packOrderedWithState(order, heur, pk, pl, used);
+    if (doGapFill) {
+        profit += gapFill(pk, pl, used, heur);
+    }
+    updateBest(profit, pl);
+    if (profit > heurBest[heur]) { heurBest[heur] = profit; heurBestPerm[heur] = order; }
+    return profit;
+}
+
+long long evalOrdered(const vector<int> &order, int heur, bool doGapFill = true) {
+    MaxRectsPacker pk;
+    vector<Placement> pl;
+    vector<int> used(M, 0);
+    long long profit = packOrderedWithState(order, heur, pk, pl, used);
+    if (doGapFill) {
+        profit += gapFill(pk, pl, used, heur);
+    }
+    return profit;
+}
+
+void packGreedy(int heur, int mode) {
+    MaxRectsPacker pk; pk.init();
+    long long profit = 0;
+    vector<Placement> pl;
+    vector<int> used(M, 0);
+    while (true) {
+        double bestScore = -1e30;
+        Rect bestRect = {-1,-1,0,0};
+        int bestIdx = -1, bestRot = 0;
+        for (int i = 0; i < M; i++) {
+            if (used[i] >= items[i].limit) continue;
+            auto &it = items[i];
+            auto tryOri = [&](int rw, int rh, int rot) {
+                int s1, s2;
+                Rect r = pk.findPosition(rw, rh, heur, s1, s2);
+                if (r.x < 0) return;
+                double score;
+                switch(mode) {
+                    case 0: score=it.density; break;
+                    case 1: score=(double)it.v; break;
+                    case 2: score=it.density/(1.0+r.x+r.y); break;
+                    case 3: score=(double)it.v/(1.0+s1); break;
+                    case 4: score=it.density*min(rw,rh); break;
+                    default: score=it.density;
+                }
+                if (score > bestScore) { bestScore=score; bestRect=r; bestIdx=i; bestRot=rot; }
+            };
+            tryOri(it.w, it.h, 0);
+            if (allowRotate && it.w!=it.h) tryOri(it.h, it.w, 1);
+        }
+        if (bestIdx < 0) break;
+        pk.placeRect(bestRect);
+        pl.push_back({items[bestIdx].type, bestRect.x, bestRect.y, bestRot});
+        profit += items[bestIdx].v; used[bestIdx]++;
+    }
+    updateBest(profit, pl);
+}
+
+// Simulated annealing over item orderings
+void saSearch(int h, double timeLimit, mt19937 &rng, bool doGapFill = true) {
+    vector<int> cur = heurBestPerm[h];
+    long long curVal = heurBest[h];
+    long long bestVal = curVal;
+    vector<int> bestPerm = cur;
+
+    double T0 = 0.1 * max(bestProfit, (long long)1);
+    double T = T0;
+    double alpha = 0.995;
+
+    int iter = 0;
+    while (elapsed() < timeLimit) {
+        // Pick a neighborhood move
+        int moveType = rng() % 3;
+        vector<int> next = cur;
+
+        if (moveType == 0) {
+            // Swap two elements
+            int i = rng() % M, j = rng() % M;
+            if (i == j) j = (j + 1) % M;
+            swap(next[i], next[j]);
+        } else if (moveType == 1) {
+            // Insert: remove element and reinsert at random position
+            int i = rng() % M;
+            int elem = next[i];
+            next.erase(next.begin() + i);
+            int j = rng() % M;
+            next.insert(next.begin() + j, elem);
+        } else {
+            // Reverse a subsequence
+            int i = rng() % M, j = rng() % M;
+            if (i > j) swap(i, j);
+            if (j - i > 1) reverse(next.begin() + i, next.begin() + j + 1);
+        }
+
+        long long newVal = evalOrdered(next, h, doGapFill);
+        double delta = (double)(newVal - curVal);
+
+        if (delta > 0 || (T > 1e-12 && ((double)(rng() % 1000000) / 1000000.0) < exp(delta / T))) {
+            cur = next;
+            curVal = newVal;
+            if (curVal > bestVal) {
+                bestVal = curVal;
+                bestPerm = cur;
+                packOrderedFull(cur, h, doGapFill);
+            }
+        }
+
+        T *= alpha;
+        iter++;
+
+        // Periodic reheat
+        if (iter % 500 == 0 && T < T0 * 0.01) {
+            T = T0 * 0.3;
+        }
+    }
+
+    // Ensure best found is recorded
+    if (bestVal > heurBest[h]) {
+        heurBest[h] = bestVal;
+        heurBestPerm[h] = bestPerm;
+    }
+    packOrderedFull(bestPerm, h, doGapFill);
+}
