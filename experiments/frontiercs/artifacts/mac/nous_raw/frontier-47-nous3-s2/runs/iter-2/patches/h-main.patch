+int main() {
+    startTime = chrono::steady_clock::now();
+    string input;
+    { ostringstream ss; ss << cin.rdbuf(); input = ss.str(); }
+
+    {
+        size_t p = input.find("\"W\"");
+        size_t c = input.find(':',p)+1;
+        while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+        binW=0; while(input[c]>='0'&&input[c]<='9') binW=binW*10+input[c++]-'0';
+        p = input.find("\"H\"");
+        c = input.find(':',p)+1;
+        while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+        binH=0; while(input[c]>='0'&&input[c]<='9') binH=binH*10+input[c++]-'0';
+        p = input.find("\"allow_rotate\"");
+        c = input.find(':',p)+1;
+        while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+        allowRotate = (input[c]=='t');
+    }
+    {
+        size_t p = input.find("\"items\"");
+        p = input.find('[', p);
+        size_t arrEnd = input.rfind(']');
+        size_t pos = p+1;
+        while(true) {
+            size_t os = input.find('{', pos);
+            if (os==string::npos || os>arrEnd) break;
+            size_t oe = input.find('}', os);
+            ItemType it;
+            size_t tp = input.find("\"type\"", os);
+            tp = input.find('"', input.find(':',tp)+1)+1;
+            it.type=""; while(input[tp]!='"') it.type+=input[tp++];
+            size_t wp = input.find("\"w\"", os);
+            size_t c = input.find(':',wp)+1;
+            while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+            it.w=0; while(input[c]>='0'&&input[c]<='9') it.w=it.w*10+input[c++]-'0';
+            size_t hp = input.find("\"h\"", os);
+            c = input.find(':',hp)+1;
+            while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+            it.h=0; while(input[c]>='0'&&input[c]<='9') it.h=it.h*10+input[c++]-'0';
+            size_t vp = input.find("\"v\"", os);
+            c = input.find(':',vp)+1;
+            while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+            it.v=0; while(input[c]>='0'&&input[c]<='9') it.v=it.v*10+input[c++]-'0';
+            size_t lp = input.find("\"limit\"", os);
+            c = input.find(':',lp)+1;
+            while(input[c]==' '||input[c]=='\n'||input[c]=='\r'||input[c]=='\t') c++;
+            it.limit=0; while(input[c]>='0'&&input[c]<='9') it.limit=it.limit*10+input[c++]-'0';
+            it.density = (double)it.v / ((double)it.w * it.h);
+            items.push_back(it);
+            pos = oe+1;
+        }
+    }
+
+    M = items.size();
+    bestProfit = 0;
+    for (int h = 0; h < 4; h++) { heurBest[h]=0; heurBestPerm[h].resize(M); iota(heurBestPerm[h].begin(),heurBestPerm[h].end(),0); }
+
+    auto mkOrd = [](auto cmp) {
+        vector<int> o(M); iota(o.begin(),o.end(),0);
+        sort(o.begin(),o.end(),cmp); return o;
+    };
+    vector<vector<int>> sorts = {
+        mkOrd([](int a,int b){return items[a].density>items[b].density;}),
+        mkOrd([](int a,int b){return items[a].v>items[b].v;}),
+        mkOrd([](int a,int b){return (long long)items[a].w*items[a].h>(long long)items[b].w*items[b].h;}),
+        mkOrd([](int a,int b){return (long long)items[a].w*items[a].h<(long long)items[b].w*items[b].h;}),
+        mkOrd([](int a,int b){return max(items[a].w,items[a].h)>max(items[b].w,items[b].h);}),
+        mkOrd([](int a,int b){return items[a].h>items[b].h;}),
+        mkOrd([](int a,int b){return items[a].w>items[b].w;}),
+        mkOrd([](int a,int b){return items[a].v*(long long)items[a].limit>items[b].v*(long long)items[b].limit;}),
+        mkOrd([](int a,int b){return items[a].w+items[a].h>items[b].w+items[b].h;}),
+    };
+
+    // Phase 1: Initial sorted orderings with gap filling (~0.05s)
+    for (auto &ord : sorts)
+        for (int h = 0; h < 4; h++)
+            packOrderedFull(ord, h, true);
+
+    // Phase 2: Greedy packing (~0.05s)
+    for (int mode = 0; mode < 5; mode++)
+        for (int h = 0; h < 4; h++)
+            packGreedy(h, mode);
+
+    // Phase 3: Permutation exhaustion for small M
+    if (M <= 8) {
+        vector<int> perm(M);
+        iota(perm.begin(), perm.end(), 0);
+        do {
+            if (elapsed() > 0.15) break;
+            for (int h = 0; h < 4; h++)
+                packOrderedFull(perm, h, true);
+        } while (next_permutation(perm.begin(), perm.end()));
+    }
+
+    // Phase 4: Simulated annealing — main search phase (~0.65s)
+    {
+        mt19937 rng(12345);
+        double saEnd = min(0.82, 0.88 - 0.06);
+        double budget = saEnd - elapsed();
+        if (budget > 0) {
+            double timePerH = budget / 4.0;
+            for (int h = 0; h < 4; h++) {
+                saSearch(h, elapsed() + timePerH, rng, true);
+            }
+        }
+    }
+
+    // Phase 5: Random restarts with SA for remaining time
+    {
+        mt19937 rng(42);
+        while (elapsed() < 0.88) {
+            int h = rng() % 4;
+            vector<int> perm = heurBestPerm[h];
+            int nSwaps = 1 + rng() % 3;
+            for (int s = 0; s < nSwaps; s++) {
+                int i = rng() % M, j = rng() % M;
+                swap(perm[i], perm[j]);
+            }
+            for (int hh = 0; hh < 4; hh++)
+                packOrderedFull(perm, hh, true);
+        }
+    }
+
+    printf("{\"placements\":[");
+    for (int i = 0; i < (int)bestPlacements.size(); i++) {
+        if (i) printf(",");
+        printf("{\"type\":\"%s\",\"x\":%d,\"y\":%d,\"rot\":%d}",
+            bestPlacements[i].type.c_str(), bestPlacements[i].x, bestPlacements[i].y, bestPlacements[i].rot);
+    }
+    printf("]}\n");
+}
