+struct MaxRectsPacker {
+    vector<Rect> freeRects;
+    void init() { freeRects.clear(); freeRects.push_back({0, 0, binW, binH}); }
+
+    // Save/restore state for branching
+    vector<Rect> save() { return freeRects; }
+    void restore(const vector<Rect> &s) { freeRects = s; }
+
+    Rect findPosition(int rw, int rh, int heuristic, int &bs1, int &bs2) {
+        Rect best = {-1,-1,rw,rh};
+        bs1 = bs2 = INT_MAX;
+        for (auto &fr : freeRects) {
+            if (rw > fr.w || rh > fr.h) continue;
+            int s1, s2;
+            switch(heuristic) {
+                case 0: s1=min(fr.w-rw,fr.h-rh); s2=max(fr.w-rw,fr.h-rh); break; // BSSF
+                case 1: s1=fr.w*fr.h-rw*rh; s2=min(fr.w-rw,fr.h-rh); break; // BAF
+                case 2: s1=fr.y; s2=fr.x; break; // BL
+                case 3: s1=max(fr.w-rw,fr.h-rh); s2=min(fr.w-rw,fr.h-rh); break; // BLSF
+                case 4: s1=(fr.w-rw)+(fr.h-rh); s2=min(fr.w-rw,fr.h-rh); break; // perimeter sum fit
+                case 5: s1=fr.y+fr.h; s2=fr.x+fr.w; break; // top-right (prefer high y+h)
+                case 6: s1=fr.x; s2=fr.y; break; // left-bottom (x primary)
+                case 7: s1=min(fr.w,fr.h)-min(rw,rh); s2=max(fr.w,fr.h)-max(rw,rh); break; // aspect ratio fit
+                // heuristics 8-9 removed (diluted search)
+                default: s1=s2=INT_MAX;
+            }
+            if (s1<bs1||(s1==bs1&&s2<bs2)) { bs1=s1; bs2=s2; best={fr.x,fr.y,rw,rh}; }
+        }
+        return best;
+    }
+
+    Rect findBestPos(int idx, int h, int &outRot) {
+        auto &it = items[idx];
+        int s1a=INT_MAX,s2a=INT_MAX,s1b=INT_MAX,s2b=INT_MAX;
+        Rect ra = findPosition(it.w, it.h, h, s1a, s2a);
+        Rect rb = {-1,-1,0,0};
+        if (allowRotate && it.w!=it.h)
+            rb = findPosition(it.h, it.w, h, s1b, s2b);
+        if (ra.x>=0 && (rb.x<0 || s1a<s1b || (s1a==s1b && s2a<=s2b))) { outRot=0; return ra; }
+        if (rb.x>=0) { outRot=1; return rb; }
+        outRot=0; return {-1,-1,0,0};
+    }
+
+    void placeRect(Rect placed) {
+        int n = freeRects.size();
+        for (int i = n-1; i >= 0; i--) {
+            auto &fr = freeRects[i];
+            if (placed.x>=fr.x+fr.w||placed.x+placed.w<=fr.x||
+                placed.y>=fr.y+fr.h||placed.y+placed.h<=fr.y) continue;
+            Rect o = fr;
+            freeRects[i] = freeRects.back(); freeRects.pop_back();
+            if (placed.x > o.x) freeRects.push_back({o.x, o.y, placed.x-o.x, o.h});
+            if (placed.x+placed.w < o.x+o.w) freeRects.push_back({placed.x+placed.w, o.y, o.x+o.w-placed.x-placed.w, o.h});
+            if (placed.y > o.y) freeRects.push_back({o.x, o.y, o.w, placed.y-o.y});
+            if (placed.y+placed.h < o.y+o.h) freeRects.push_back({o.x, placed.y+placed.h, o.w, o.y+o.h-placed.y-placed.h});
+        }
+        n = freeRects.size();
+        for (int i = 0; i < n; i++) {
+            for (int j = i+1; j < n; ) {
+                auto &a=freeRects[i], &b=freeRects[j];
+                bool ab = a.x<=b.x && a.y<=b.y && a.x+a.w>=b.x+b.w && a.y+a.h>=b.y+b.h;
+                bool ba = b.x<=a.x && b.y<=a.y && b.x+b.w>=a.x+a.w && b.y+b.h>=a.y+a.h;
+                if (ab) { freeRects[j]=freeRects[--n]; freeRects.resize(n); }
+                else if (ba) { freeRects[i]=freeRects[--n]; freeRects.resize(n); j=i+1; }
+                else j++;
+            }
+        }
+    }
+};
