+// Pack with per-item heuristic AND per-item rotation mode
+// rotMode per item: 0=auto(try both, pick best), 1=normal only, 2=rotated only
+long long evalMultiHeurRotFast(const vector<int> &order, const vector<int> &heurPerItem, const vector<int> &rotPerItem) {
+    MaxRectsPacker pk; pk.init();
+    long long profit = 0;
+    vector<int> used(M, 0);
+    for (int idx : order) {
+        auto &it = items[idx];
+        int h = heurPerItem[idx];
+        int rm = rotPerItem[idx];
+        while (used[idx] < it.limit) {
+            int s1a=INT_MAX,s2a=INT_MAX,s1b=INT_MAX,s2b=INT_MAX;
+            Rect ra={-1,-1,0,0}, rb={-1,-1,0,0};
+            if (rm != 2) ra = pk.findPosition(it.w, it.h, h, s1a, s2a);
+            if (rm != 1 && allowRotate && it.w != it.h) rb = pk.findPosition(it.h, it.w, h, s1b, s2b);
+            Rect chosen; int rot;
+            if (ra.x>=0 && (rb.x<0 || s1a<s1b || (s1a==s1b && s2a<=s2b))) { chosen=ra; rot=0; }
+            else if (rb.x>=0) { chosen=rb; rot=1; }
+            else break;
+            pk.placeRect(chosen);
+            profit += it.v; used[idx]++;
+        }
+    }
+    return profit;
+}
