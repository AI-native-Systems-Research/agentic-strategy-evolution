+// Pack with ordering using a fixed heuristic
+long long packOrderedFull(const vector<int> &order, int heur) {
+    MaxRectsPacker pk; pk.init();
+    long long profit = 0;
+    vector<Placement> pl;
+    vector<int> used(M, 0);
+    for (int idx : order) {
+        auto &it = items[idx];
+        while (used[idx] < it.limit) {
+            int rot; Rect r = pk.findBestPos(idx, heur, rot);
+            if (r.x < 0) break;
+            pk.placeRect(r);
+            pl.push_back({it.type, r.x, r.y, rot});
+            profit += it.v; used[idx]++;
+        }
+    }
+    updateBest(profit, pl);
+    if (profit > heurBest[heur]) { heurBest[heur] = profit; heurBestPerm[heur] = order; }
+    return profit;
+}
