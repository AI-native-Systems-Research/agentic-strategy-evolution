+// Gap filling pass
+long long gapFill(MaxRectsPacker &pk, vector<Placement> &pl, vector<int> &used, int heur) {
+    long long extraProfit = 0;
+    vector<int> densOrder(M);
+    iota(densOrder.begin(), densOrder.end(), 0);
+    sort(densOrder.begin(), densOrder.end(), [](int a, int b) {
+        return items[a].density > items[b].density;
+    });
+    bool placed = true;
+    while (placed) {
+        placed = false;
+        for (int idx : densOrder) {
+            if (used[idx] >= items[idx].limit) continue;
+            int rot;
+            Rect r = pk.findBestPos(idx, heur, rot);
+            if (r.x < 0) continue;
+            pk.placeRect(r);
+            pl.push_back({items[idx].type, r.x, r.y, rot});
+            extraProfit += items[idx].v;
+            used[idx]++;
+            placed = true;
+        }
+    }
+    return extraProfit;
+}
