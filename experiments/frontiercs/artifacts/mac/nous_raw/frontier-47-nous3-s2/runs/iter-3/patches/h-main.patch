+void hillClimb(int h, double timeLimit) {
+    vector<int> cur = heurBestPerm[h];
+    long long curVal = heurBest[h];
+    while (elapsed() < timeLimit) {
+        bool improved = false;
+        for (int i = 0; i < M && elapsed() < timeLimit; i++) {
+            for (int j = i+1; j < M; j++) {
+                swap(cur[i], cur[j]);
+                long long val = evalOrderedFast(cur, h);
+                if (val > curVal) { curVal = val; improved = true; packOrderedFull(cur, h); }
+                else swap(cur[i], cur[j]);
+            }
+        }
+        for (int i = 0; i < M && elapsed() < timeLimit; i++) {
+            int elem = cur[i];
+            cur.erase(cur.begin()+i);
+            bool found = false;
+            for (int j = 0; j < M; j++) {
+                if (j == i) continue;
+                cur.insert(cur.begin()+j, elem);
+                long long val = evalOrderedFast(cur, h);
+                if (val > curVal) { curVal = val; improved = true; found = true; packOrderedFull(cur, h); break; }
+                cur.erase(cur.begin()+j);
+            }
+            if (found) break;
+            cur.insert(cur.begin()+i, elem);
+        }
+        if (!improved) break;
+    }
+}
