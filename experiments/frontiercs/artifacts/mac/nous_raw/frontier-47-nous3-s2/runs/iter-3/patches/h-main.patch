+void packGreedy(int heur, int mode) {
+    MaxRectsPacker pk; pk.init();
+    long long profit = 0;
+    vector<Placement> pl;
+    vector<int> used(M, 0);
+    while (true) {
+        double bestScore = -1e30;
+        Rect bestRect = {-1,-1,0,0};
+        int bestIdx = -1, bestRot = 0;
+        for (int i = 0; i < M; i++) {
+            if (used[i] >= items[i].limit) continue;
+            auto &it = items[i];
+            auto tryOri = [&](int rw, int rh, int rot) {
+                int s1, s2;
+                Rect r = pk.findPosition(rw, rh, heur, s1, s2);
+                if (r.x < 0) return;
+                double score;
+                switch(mode) {
+                    case 0: score=it.density; break;
+                    case 1: score=(double)it.v; break;
+                    case 2: score=it.density/(1.0+r.x+r.y); break;
+                    case 3: score=(double)it.v/(1.0+s1); break;
+                    case 4: score=it.density*min(rw,rh); break;
+                    default: score=it.density;
+                }
+                if (score > bestScore) { bestScore=score; bestRect=r; bestIdx=i; bestRot=rot; }
+            };
+            tryOri(it.w, it.h, 0);
+            if (allowRotate && it.w!=it.h) tryOri(it.h, it.w, 1);
+        }
+        if (bestIdx < 0) break;
+        pk.placeRect(bestRect);
+        pl.push_back({items[bestIdx].type, bestRect.x, bestRect.y, bestRot});
+        profit += items[bestIdx].v; used[bestIdx]++;
+    }
+    updateBest(profit, pl);
+}
