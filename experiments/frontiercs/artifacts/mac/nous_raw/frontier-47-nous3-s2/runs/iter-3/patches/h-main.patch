+// SA over joint ordering + per-item heuristic + per-item rotation mode
+void saJointSearch(double timeLimit, mt19937 &rng) {
+    // Start from best known
+    int bestH = 0;
+    for (int h = 1; h < NH; h++)
+        if (heurBest[h] > heurBest[bestH]) bestH = h;
+
+    vector<int> curOrd = heurBestPerm[bestH];
+    vector<int> curHeur(M, bestH);
+    vector<int> curRot(M, 0); // all auto initially
+    long long curVal = evalMultiHeurRotFast(curOrd, curHeur, curRot);
+    long long bestVal = curVal;
+    vector<int> bestOrd = curOrd, bestHeur = curHeur, bestRot = curRot;
+
+    double T0 = max(1.0, 0.05 * (double)bestProfit);
+    double T = T0;
+    int iter = 0;
+
+    while (elapsed() < timeLimit) {
+        vector<int> nextOrd = curOrd;
+        vector<int> nextHeur = curHeur;
+        vector<int> nextRot = curRot;
+        int moveType = rng() % 16;
+
+        if (moveType < 3) {
+            // Swap ordering
+            int i = rng() % M, j = rng() % M;
+            if (i == j) j = (j + 1) % M;
+            swap(nextOrd[i], nextOrd[j]);
+        } else if (moveType < 5) {
+            // Insert
+            int i = rng() % M;
+            int elem = nextOrd[i];
+            nextOrd.erase(nextOrd.begin() + i);
+            int j = rng() % M;
+            nextOrd.insert(nextOrd.begin() + j, elem);
+        } else if (moveType < 6) {
+            // Reverse subsequence
+            int i = rng() % M, j = rng() % M;
+            if (i > j) swap(i, j);
+            if (j - i > 1) reverse(nextOrd.begin() + i, nextOrd.begin() + j + 1);
+        } else if (moveType < 11) {
+            // Change heuristic for one item (highest weight — key lever per RP-3)
+            int i = rng() % M;
+            nextHeur[nextOrd[i]] = rng() % NH;
+        } else if (moveType < 13) {
+            // Change heuristics for 2-3 items at once
+            int n = 2 + rng() % 2;
+            for (int k = 0; k < n; k++)
+                nextHeur[rng() % M] = rng() % NH;
+        } else if (moveType < 15) {
+            // Change rotation mode for one item
+            if (allowRotate) {
+                int i = rng() % M;
+                nextRot[nextOrd[i]] = rng() % 3;
+            } else {
+                // If rotation not allowed, change heuristic instead
+                int i = rng() % M;
+                nextHeur[nextOrd[i]] = rng() % NH;
+            }
+        } else {
+            // Combined: swap + change heuristic
+            int i = rng() % M, j = rng() % M;
+            if (i != j) swap(nextOrd[i], nextOrd[j]);
+            nextHeur[nextOrd[rng() % M]] = rng() % NH;
+        }
+
+        long long newVal = evalMultiHeurRotFast(nextOrd, nextHeur, nextRot);
+        double delta = (double)(newVal - curVal);
+
+        if (delta > 0 || (T > 0.01 && ((double)(rng() % 1000000) / 1000000.0) < exp(delta / T))) {
+            curOrd = nextOrd;
+            curHeur = nextHeur;
+            curRot = nextRot;
+            curVal = newVal;
+            if (curVal > bestVal) {
+                bestVal = curVal;
+                bestOrd = curOrd;
+                bestHeur = curHeur;
+                bestRot = curRot;
+                packMultiHeurRot(bestOrd, bestHeur, bestRot);
+            }
+        }
+
+        T *= 0.995;
+        iter++;
+        if (iter % 500 == 0 && T < 0.3) {
+            T = T0 * 0.3;
+        }
+    }
+
+    // Final recording
+    packMultiHeurRot(bestOrd, bestHeur, bestRot);
+}
