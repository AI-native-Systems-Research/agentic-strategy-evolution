--- a/solution.cpp
+++ b/solution.cpp
@@ -1,3 +1,135 @@
 #include <bits/stdc++.h>
 using namespace std;
-int main(){return 0;}
+
+int main(){
+    ios_base::sync_with_stdio(false);
+    cin.tie(NULL);
+
+    auto t0=chrono::steady_clock::now();
+    auto ms=[&]()->double{return chrono::duration<double,milli>(chrono::steady_clock::now()-t0).count();};
+
+    int N;
+    cin >> N;
+    vector<double> x(N), y(N);
+    for(int i=0;i<N;i++) cin>>x[i]>>y[i];
+
+    if(N<=2){
+        cout<<N+1<<"\n";
+        for(int i=0;i<=N;i++)cout<<(i<N?i:0)<<"\n";
+        return 0;
+    }
+
+    vector<bool> is_prime(N,false);
+    {
+        vector<bool> sv(N,true);
+        if(N>0)sv[0]=false;if(N>1)sv[1]=false;
+        for(int i=2;i<N;i++){
+            if(sv[i]){is_prime[i]=true;
+                for(long long j=(long long)i*i;j<N;j+=i)sv[j]=false;}
+        }
+    }
+
+    auto eucl=[&](int a,int b)->double{
+        double dx=x[a]-x[b],dy=y[a]-y[b];return sqrt(dx*dx+dy*dy);
+    };
+
+    double minx=x[0],maxx=x[N-1];
+    double miny=*min_element(y.begin(),y.end()),maxy=*max_element(y.begin(),y.end());
+    int G=max(1,(int)sqrt((double)N/4.0));
+    double cw=(maxx-minx+1.0)/G,ch=(maxy-miny+1.0)/G;
+    auto cell=[&](int i)->pair<int,int>{return{min(G-1,(int)((x[i]-minx)/cw)),min(G-1,(int)((y[i]-miny)/ch))};};
+    vector<vector<vector<int>>> grid(G,vector<vector<int>>(G));
+    for(int i=0;i<N;i++){auto[a,b]=cell(i);grid[a][b].push_back(i);}
+
+    // NN construction
+    vector<bool> used(N,false);
+    vector<int> tour={0}; tour.reserve(N+1); used[0]=true;
+    for(int s=1;s<N;s++){
+        int cur=tour.back();auto[cx,cy]=cell(cur);
+        int best=-1;double bd=1e18;
+        for(int r=0;r<=G;r++){
+            if(best!=-1){double md=max(0.0,(double)(r-1))*min(cw,ch);if(md>bd)break;}
+            for(int dx=-r;dx<=r;dx++)for(int dy=-r;dy<=r;dy++){
+                if(abs(dx)!=r&&abs(dy)!=r)continue;
+                int nx=cx+dx,ny=cy+dy;
+                if(nx<0||nx>=G||ny<0||ny>=G)continue;
+                for(int c:grid[nx][ny])if(!used[c]){double d=eucl(cur,c);if(d<bd){bd=d;best=c;}}
+            }
+            if(best!=-1&&r>=1)break;
+        }
+        used[best]=true;tour.push_back(best);
+    }
+    tour.push_back(0);
+
+    double budget=1500.0;
+
+    // NN candidate lists (time-bounded)
+    int K = N<=5000 ? 10 : (N<=50000 ? 7 : 5);
+    vector<vector<int>> nn(N);
+    double nn_deadline = min(ms()+300.0, budget*0.2); // cap at 300ms or 20% of budget
+    for(int i=0;i<N&&ms()<nn_deadline;i++){
+        auto[cx,cy]=cell(i);
+        vector<pair<double,int>> cands;
+        for(int r=0;r<=G;r++){
+            for(int dx=-r;dx<=r;dx++)for(int dy=-r;dy<=r;dy++){
+                if(abs(dx)!=r&&abs(dy)!=r)continue;
+                int nx=cx+dx,ny=cy+dy;
+                if(nx<0||nx>=G||ny<0||ny>=G)continue;
+                for(int c:grid[nx][ny])if(c!=i)cands.push_back({eucl(i,c),c});
+            }
+            if((int)cands.size()>=K*3&&r>=1)break;
+        }
+        sort(cands.begin(),cands.end());
+        int take=min((int)cands.size(),K);
+        nn[i].resize(take);
+        for(int k=0;k<take;k++) nn[i][k]=cands[k].second;
+    }
+
+    vector<int> pos(N);
+    for(int i=0;i<N;i++) pos[tour[i]]=i;
+
+    int seg_limit = N<=5000 ? 500 : (N<=50000 ? 300 : 200);
+
+    auto fast_delta=[&](int i,int j)->double{
+        double d = eucl(tour[i],tour[j]) + eucl(tour[i+1],tour[j+1])
+                 - eucl(tour[i],tour[i+1]) - eucl(tour[j],tour[j+1]);
+        int kstart = ((i+1)+9)/10*10;
+        if(kstart<10) kstart=10;
+        for(int k=kstart; k<=j+1&&k<=N; k+=10){
+            int ns_pos = (k-1>=i+1&&k-1<=j) ? (i+1+j-(k-1)) : (k-1);
+            int nd_pos = (k>=i+1&&k<=j) ? (i+1+j-k) : k;
+            double op = is_prime[tour[k-1]] ? 0.0 : 0.1*eucl(tour[k-1],tour[k]);
+            double np = is_prime[tour[ns_pos]] ? 0.0 : 0.1*eucl(tour[ns_pos],tour[nd_pos]);
+            d += np - op;
+        }
+        return d;
+    };
+
+    // Candidate-list 2-opt until convergence or budget
+    bool improved=true;
+    while(improved && ms()<budget){
+        improved=false;
+        for(int idx=1;idx<N&&ms()<budget;idx++){
+            int ci=tour[idx];
+            if(nn[ci].empty()) continue;
+            for(int nb:nn[ci]){
+                int j=pos[nb];
+                int ii,jj;
+                if(j>idx){ii=idx-1;jj=j;}
+                else if(j<idx-1){ii=j;jj=idx;}
+                else continue;
+                if(jj-ii<2||jj>=N||jj-ii>seg_limit) continue;
+                double d=fast_delta(ii,jj);
+                if(d<-1e-10){
+                    reverse(tour.begin()+ii+1,tour.begin()+jj+1);
+                    for(int p=ii+1;p<=jj;p++) pos[tour[p]]=p;
+                    improved=true;
+                }
+            }
+        }
+    }
+
+    cout<<N+1<<"\n";
+    for(int i=0;i<=N;i++)cout<<tour[i]<<"\n";
+    return 0;
+}
