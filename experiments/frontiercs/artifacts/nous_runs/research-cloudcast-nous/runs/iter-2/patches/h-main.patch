+                            parent[S][v] = ('split', sub, comp)
+                sub = (sub - 1) & S
+
+        # Relax using shortest paths: dp[S][v] = min over u: dp[S][u] + dist[v][u]
+        # This is equivalent to Dijkstra relaxation on the Steiner states
+        for v in range(n):
