+
+    # Precompute single-source directed shortest paths from every node (cost-weighted)
+    # dist[i][j] = min cost from nodes[i] to nodes[j] using directed edges
+    INF = float('inf')
+
+    # Use Dijkstra from each node
+    dist = [[INF] * n for _ in range(n)]
+    next_hop = [[None] * n for _ in range(n)]  # for path reconstruction
+
+    for i in range(n):
+        u = nodes[i]
