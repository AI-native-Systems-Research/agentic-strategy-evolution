+        heap = [(0, i)]
+        visited = [False] * n
+        d = [INF] * n
+        pred = [None] * n
+        d[i] = 0
+        while heap:
+            cost_so_far, vi = heapq.heappop(heap)
+            if visited[vi]:
+                continue
+            visited[vi] = True
+            d[vi] = cost_so_far
+            for _, w, edata in h.edges(nodes[vi], data=True):
+                wi = node_idx[w]
+                new_cost = cost_so_far + edata['cost']
+                if new_cost < d[wi]:
+                    d[wi] = new_cost
+                    pred[wi] = vi
+                    heapq.heappush(heap, (new_cost, wi))
+        dist[i] = d
+
+        # Build next_hop for path reconstruction
+        for j in range(n):
+            if pred[j] is not None:
+                # Trace back to find the first hop from i
+                cur = j
+                while pred[cur] != i and pred[cur] is not None:
+                    cur = pred[cur]
+                next_hop[i][j] = cur if pred[cur] == i else None
+            elif i == j:
+                next_hop[i][j] = i
+
+    # Dreyfus-Wagner DP
+    # dp[S][v] = min cost of a directed Steiner tree rooted at v that reaches all terminals in subset S
+    # S is a bitmask over terminals (k bits)
+    full_mask = (1 << k) - 1
+    dp = [[INF] * n for _ in range(1 << k)]
