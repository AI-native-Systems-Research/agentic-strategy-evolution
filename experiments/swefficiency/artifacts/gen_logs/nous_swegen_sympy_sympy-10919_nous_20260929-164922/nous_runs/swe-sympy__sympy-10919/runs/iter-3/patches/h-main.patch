+    Returns dict: j -> (paired_items, unpaired_item_or_None, c_h_arr, c_D_arr, c_count)
+    paired_items: [(h, D), ...] for h=1..(j-1)//2 — these get doubled
+    unpaired: (h, D) or None for the self-pairing term (j=2 only)
+    c_h_arr, c_D_arr: ctypes arrays for C float-path helper (or None)
+    c_count: number of paired items
+    """
+    key = M
+    if key in _coprime_cache:
+        return _coprime_cache[key]
+    data = {}
+    use_c = _kloosterman_func is not None
+    for j in range(2, M):
