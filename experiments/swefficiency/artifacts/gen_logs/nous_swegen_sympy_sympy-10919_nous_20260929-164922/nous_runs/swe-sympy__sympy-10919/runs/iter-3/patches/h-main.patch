+#include <math.h>
+
+/*
+ * Compute the Kloosterman sum for the float path (prec <= 53).
+ * Returns 2 * sum(cos(factor * (D[i] + neg24n * h[i]))) for i=0..count-1
+ * plus cos(factor * (D_unpaired + neg24n * h_unpaired)) if has_unpaired.
+ */
+double kloosterman_sum_float(
+    const long* h_vals,
+    const long* D_vals, 
+    int count,
+    long neg24n,
+    double factor,
+    long h_unpaired,
+    long D_unpaired,
+    int has_unpaired
+) {
+    double sum = 0.0;
+    int i;
+    for (i = 0; i < count; i++) {
+        double arg = factor * ((double)D_vals[i] + (double)neg24n * (double)h_vals[i]);
+        sum += cos(arg);
+    }
+    sum *= 2.0;
+    if (has_unpaired) {
+        double arg = factor * ((double)D_unpaired + (double)neg24n * (double)h_unpaired);
+        sum += cos(arg);
+    }
+    return sum;
+}
