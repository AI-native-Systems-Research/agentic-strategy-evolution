+@lru_cache(maxsize=None)
+def _d_dedekind(h, k):
+    """Compute D(h,k) = 12*k*s(h,k) where s is the Dedekind sum.
+    Uses reciprocity for O(log k) instead of O(k)."""
+    if k <= 2:
+        return 0
+    h = h % k
+    if h == 0:
+        return 0
+    if h == 1:
+        return (k - 1) * (k - 2)
+    return (h*h + k*k + 1 - 3*h*k - k*_d_dedekind(k % h, h)) // h
