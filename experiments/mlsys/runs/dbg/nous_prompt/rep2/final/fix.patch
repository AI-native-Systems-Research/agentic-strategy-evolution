+// TestPreemption_TotalOutputTokens_NoDoubleCount verifies that preempted requests
+// do not inflate TotalOutputTokens. When a request is preempted and rescheduled,
+// its output tokens must be counted exactly once.
+func TestPreemption_TotalOutputTokens_NoDoubleCount(t *testing.T) {
+	// GIVEN a KV cache small enough to force preemption when two requests compete.
+	// Block size 16, 4 blocks total = 64 token capacity.
+	// Each request needs ceil(48/16)=3 input blocks; both cannot fit simultaneously,
+	// so the second request's scheduling preempts the first.
+	cfg := SimConfig{
+		Horizon:             math.MaxInt64,
+		Seed:                42,
+		KVCacheConfig:       NewKVCacheConfig(4, 16, 0, 0, 0, 0),
+		BatchConfig:         NewBatchConfig(256, 2048, 0),
+		LatencyCoeffs:       NewLatencyCoeffs([]float64{1000, 10, 5}, []float64{100, 1, 100}),
+		ModelHardwareConfig: NewModelHardwareConfig(ModelConfig{}, HardwareCalib{}, "test-model", "H100", 1, "blackbox", 0),
+	}
+	sim := mustNewSimulator(t, cfg)
+
+	outputLen1 := 10
+	outputLen2 := 8
+	req1 := &Request{
+		ID:           "req_0",
+		ArrivalTime:  0,
+		InputTokens:  make([]int, 48),
+		OutputTokens: make([]int, outputLen1),
+		State:        StateQueued,
+	}
+	req2 := &Request{
+		ID:           "req_1",
+		ArrivalTime:  1,
+		InputTokens:  make([]int, 48),
+		OutputTokens: make([]int, outputLen2),
+		State:        StateQueued,
+	}
+
+	sim.InjectArrival(req1)
+	sim.InjectArrival(req2)
+	sim.Run()
+
+	// THEN both requests must complete
+	if sim.Metrics.CompletedRequests != 2 {
+		t.Fatalf("CompletedRequests: got %d, want 2", sim.Metrics.CompletedRequests)
+	}
+
+	// AND preemption must have occurred (precondition for this test)
+	if sim.Metrics.PreemptionCount == 0 {
+		t.Fatal("expected preemption_count > 0 — test precondition failed (KV cache not small enough)")
+	}
+
+	// AND TotalOutputTokens must match what a no-preemption run would produce.
+	// The completion threshold uses max(len(OutputTokens),1)-1, so each completed
+	// request contributes (outputLen - 1) tokens to TotalOutputTokens.
+	// Preemption must not inflate this count.
+	expectedOutput := (outputLen1 - 1) + (outputLen2 - 1)
+	if sim.Metrics.TotalOutputTokens != expectedOutput {
+		t.Errorf("TotalOutputTokens: got %d, want %d (preemption caused double-counting)",
+			sim.Metrics.TotalOutputTokens, expectedOutput)
+	}
+}
