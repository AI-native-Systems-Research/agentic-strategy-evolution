+metadata:
+  iteration: 1
+  family: "output-token-preemption-double-count"
+  research_question: "When KV cache pressure causes preemption, total_output_tokens is inflated because preempted requests re-execute decode steps and each step unconditionally increments the counter."
+  complexity_tier: 1
+  tier_justification: "iter 1, single mechanism (decode token counting during preemption re-execution)"
+
+arms:
+  - type: h-main
+    prediction: "After adding OutputTokensCounted tracking to Request and gating TotalOutputTokens++ on genuinely new decode progress, total_output_tokens with small KV (preemption) will equal total_output_tokens with large KV (no preemption) for identical workloads."
+    mechanism: "sim/batch_formation.go:232 resets ProgressIndex to 0 on preemption. After rescheduling, the request re-executes all prefill and decode steps. sim/simulator.go:647 unconditionally increments TotalOutputTokens on each decode step, causing tokens generated before preemption to be counted again. Fix: track per-request decode progress high-water mark (OutputTokensCounted) and only increment TotalOutputTokens when decode progress exceeds this mark."
+    diagnostic: "If prediction fails, check whether OutputTokensCounted is properly preserved across preemption (not reset to 0) and whether decodeProgress computation is correct."
+    code_changes:
+      - file: "sim/request.go"
+        intent: "Add OutputTokensCounted int64 field to Request struct. This field survives preemption (is NOT reset when ProgressIndex is reset to 0) and tracks the high-water mark of decode tokens already counted in TotalOutputTokens."
+        rationale: "Provides per-request memory of already-counted tokens across preemption cycles."
+      - file: "sim/simulator.go"
+        intent: "In executeBatchStep decode branch, replace unconditional TotalOutputTokens++ with a guard: only increment when (ProgressIndex - len(InputTokens)) > OutputTokensCounted, then update OutputTokensCounted."
+        rationale: "Prevents double-counting after preemption by skipping already-counted decode progress."
+
+experiment_spec:
+  preflight_commands:
+    - "go build -o blis main.go"
+  verified_parameters:
+    model: "qwen/qwen3-14b"
+    rate: 20
+    num_requests: 200
+    seed: 42
+    total_kv_blocks_small: 600
+  unlocked_parameters_audit:
+    - name: "block_size_tokens"
+      default_value: 16
+      justification: "Standard block size; does not affect the double-counting mechanism."
+    - name: "max_model_len"
+      default_value: 0
+      justification: "Unlimited; does not interact with preemption token counting."
