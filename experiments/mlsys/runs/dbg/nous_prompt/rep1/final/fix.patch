+// TestTotalOutputTokens_PreemptionInvariant verifies that TotalOutputTokens is
+// identical regardless of preemption. Two simulators run the same requests: one
+// with a large KV cache (no preemption) and one with a tiny cache (forced
+// preemption). Both must report the same TotalOutputTokens.
+func TestTotalOutputTokens_PreemptionInvariant(t *testing.T) {
+	// 3 requests with small input (1 block each at blockSize=16) and long output.
+	// Small KV cache: 3 requests initially fit (3 blocks), but decode growth fills
+	// the cache forcing preemption. Large KV cache: no preemption.
+	// Both must report the same TotalOutputTokens.
+	makeRequests := func(rng *rand.Rand) []*Request {
+		reqs := make([]*Request, 3)
+		for i := range reqs {
+			reqs[i] = &Request{
+				ID:           fmt.Sprintf("req-%d", i),
+				InputTokens:  GenerateRandomTokenIDs(rng, 16),
+				OutputTokens: GenerateRandomTokenIDs(rng, 40),
+				ArrivalTime:  0,
+				State:        StateQueued,
+			}
+		}
+		return reqs
+	}
+
+	baseCfg := SimConfig{
+		Horizon:             100_000_000,
+		Seed:                99,
+		BatchConfig:         NewBatchConfig(4, 2048, 0),
+		LatencyCoeffs:       NewLatencyCoeffs([]float64{100, 10, 5}, []float64{0, 0, 0}),
+		ModelHardwareConfig: NewModelHardwareConfig(ModelConfig{}, HardwareCalib{}, "test", "H100", 1, "blackbox", 0),
+	}
+
+	// Large KV cache: no preemption
+	largeCfg := baseCfg
+	largeCfg.KVCacheConfig = NewKVCacheConfig(10000, 16, 0, 0, 0, 0)
+	simLarge := mustNewSimulator(t, largeCfg)
+	for _, r := range makeRequests(simLarge.WorkloadRNG()) {
+		simLarge.InjectArrival(r)
+	}
+	simLarge.Run()
+
+	// Tight KV cache: 3 requests × 1 prefill block = 3 blocks initially.
+	// Each request generates 40 decode tokens → needs ceil(56/16)=4 blocks total.
+	// With only 6 blocks, simultaneous decode growth triggers preemption.
+	smallCfg := baseCfg
+	smallCfg.KVCacheConfig = NewKVCacheConfig(6, 16, 0, 0, 0, 0)
+	simSmall := mustNewSimulator(t, smallCfg)
+	for _, r := range makeRequests(simSmall.WorkloadRNG()) {
+		simSmall.InjectArrival(r)
+	}
+	simSmall.Run()
+
+	if simSmall.Metrics.CompletedRequests != simLarge.Metrics.CompletedRequests {
+		t.Fatalf("completed requests differ: small=%d large=%d",
+			simSmall.Metrics.CompletedRequests, simLarge.Metrics.CompletedRequests)
+	}
+
+	if simSmall.Metrics.PreemptionCount == 0 {
+		t.Fatal("expected preemptions with tiny KV cache but got 0")
+	}
+
+	if simSmall.Metrics.TotalOutputTokens != simLarge.Metrics.TotalOutputTokens {
+		t.Errorf("TotalOutputTokens differs under preemption: small_kv=%d (preemptions=%d) large_kv=%d (preemptions=%d); want equal",
+			simSmall.Metrics.TotalOutputTokens, simSmall.Metrics.PreemptionCount,
+			simLarge.Metrics.TotalOutputTokens, simLarge.Metrics.PreemptionCount)
+	}
+}
