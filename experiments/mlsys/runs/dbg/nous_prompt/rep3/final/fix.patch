+// TestPreemption_TotalOutputTokens_NoDoubleCount verifies that preemption does not
+// inflate TotalOutputTokens. When requests are preempted and re-executed, output
+// tokens generated before preemption must not be counted again.
+func TestPreemption_TotalOutputTokens_NoDoubleCount(t *testing.T) {
+	baseCfg := SimConfig{
+		Horizon:             math.MaxInt64,
+		Seed:                42,
+		BatchConfig:         NewBatchConfig(256, 2048, 0),
+		LatencyCoeffs:       NewLatencyCoeffs([]float64{1000, 10, 5}, []float64{100, 1, 100}),
+		ModelHardwareConfig: NewModelHardwareConfig(ModelConfig{}, HardwareCalib{}, "test", "H100", 1, "blackbox", 0),
+	}
+
+	requests := testGenerateRequests(42, math.MaxInt64, 50.0/1e6, 20,
+		0, 100, 20, 10, 200, 50, 10, 10, 100)
+
+	// Run 1: large KV cache — no preemption
+	largeCfg := baseCfg
+	largeCfg.KVCacheConfig = NewKVCacheConfig(10000, 16, 0, 0, 0, 0)
+	simLarge := mustNewSimulator(t, largeCfg)
+	for _, req := range requests {
+		simLarge.InjectArrival(req)
+	}
+	simLarge.Run()
+
+	if simLarge.Metrics.PreemptionCount != 0 {
+		t.Fatalf("large KV run had %d preemptions, expected 0", simLarge.Metrics.PreemptionCount)
+	}
+
+	// Run 2: small KV cache — forces preemption
+	requests2 := testGenerateRequests(42, math.MaxInt64, 50.0/1e6, 20,
+		0, 100, 20, 10, 200, 50, 10, 10, 100)
+
+	smallCfg := baseCfg
+	smallCfg.KVCacheConfig = NewKVCacheConfig(15, 16, 0, 0, 0, 0)
+	simSmall := mustNewSimulator(t, smallCfg)
+	for _, req := range requests2 {
+		simSmall.InjectArrival(req)
+	}
+	simSmall.Run()
+
+	if simSmall.Metrics.PreemptionCount == 0 {
+		t.Fatal("small KV run had 0 preemptions, test requires preemption to exercise the fix")
+	}
+
+	if simSmall.Metrics.CompletedRequests != simLarge.Metrics.CompletedRequests {
+		t.Fatalf("completed requests differ: small=%d large=%d",
+			simSmall.Metrics.CompletedRequests, simLarge.Metrics.CompletedRequests)
+	}
+
+	if simSmall.Metrics.TotalOutputTokens != simLarge.Metrics.TotalOutputTokens {
+		t.Errorf("TotalOutputTokens: small_kv=%d, large_kv=%d; preemption should not inflate output token count",
+			simSmall.Metrics.TotalOutputTokens, simLarge.Metrics.TotalOutputTokens)
+	}
+}
