+// TestPreempt_TotalOutputTokens_NoDoubleCounting verifies that TotalOutputTokens
+// is identical whether or not preemption occurs, for the same set of requests.
+// Regression test: before the fix, preempted requests that re-entered the decode
+// phase had their output tokens counted again, inflating TotalOutputTokens.
+func TestPreempt_TotalOutputTokens_NoDoubleCounting(t *testing.T) {
+	makeRequests := func() (*Request, *Request) {
+		return &Request{
+				ID:           "r1",
+				ArrivalTime:  0,
+				InputTokens:  []int{1, 2, 3, 4},
+				OutputTokens: []int{10, 20, 30},
+				MaxOutputLen: 3,
+				State:        StateQueued,
+			}, &Request{
+				ID:           "r2",
+				ArrivalTime:  1,
+				InputTokens:  []int{5, 6, 7, 8},
+				OutputTokens: []int{40, 50, 60},
+				MaxOutputLen: 3,
+				State:        StateQueued,
+			}
+	}
+
+	// Baseline: large KV cache, no preemption.
+	kvLarge := MustNewKVCacheState(100, 1)
+	cfgLarge := SimConfig{
+		Horizon:       10_000_000,
+		KVCacheConfig: NewKVCacheConfig(100, 1, 0, 0, 0, 0),
+		BatchConfig:   NewBatchConfig(10, 10000, 0),
+		Seed:          42,
+	}
+	simLarge, err := NewSimulator(cfgLarge, kvLarge, &fixedOverheadModel{})
+	if err != nil {
+		t.Fatalf("NewSimulator (large): %v", err)
+	}
+	r1L, r2L := makeRequests()
+	simLarge.InjectArrival(r1L)
+	simLarge.InjectArrival(r2L)
+	simLarge.Run()
+
+	if simLarge.Metrics.PreemptionCount != 0 {
+		t.Fatalf("baseline: expected 0 preemptions, got %d", simLarge.Metrics.PreemptionCount)
+	}
+	baselineTokens := simLarge.Metrics.TotalOutputTokens
+
+	// Test: small KV cache, forces preemption.
+	// 10 blocks for 2 requests needing 7 each: cannot coexist.
+	kvSmall := MustNewKVCacheState(10, 1)
+	cfgSmall := SimConfig{
+		Horizon:       10_000_000,
+		KVCacheConfig: NewKVCacheConfig(10, 1, 0, 0, 0, 0),
+		BatchConfig:   NewBatchConfig(10, 10000, 0),
+		Seed:          42,
+	}
+	simSmall, err := NewSimulator(cfgSmall, kvSmall, &fixedOverheadModel{})
+	if err != nil {
+		t.Fatalf("NewSimulator (small): %v", err)
+	}
+	r1S, r2S := makeRequests()
+	simSmall.InjectArrival(r1S)
+	simSmall.InjectArrival(r2S)
+	simSmall.Run()
+
+	if simSmall.Metrics.PreemptionCount == 0 {
+		t.Fatal("small KV: expected at least one preemption, got 0")
+	}
+	if simSmall.Metrics.CompletedRequests != 2 {
+		t.Fatalf("small KV: expected 2 completed requests, got %d", simSmall.Metrics.CompletedRequests)
+	}
+
+	if simSmall.Metrics.TotalOutputTokens != baselineTokens {
+		t.Errorf("TotalOutputTokens mismatch: preemption run = %d, baseline (no preemption) = %d; "+
+			"preemptions = %d — output tokens double-counted on preemption",
+			simSmall.Metrics.TotalOutputTokens, baselineTokens, simSmall.Metrics.PreemptionCount)
+	}
+}
