+// TestSimulator_PreemptionDoesNotInflateOutputTokens verifies that
+// TotalOutputTokens is identical whether preemptions occur or not.
+// Regression test for double-counting bug: per-step TotalOutputTokens++
+// was not reverted on preemption, so re-decoded tokens were counted twice.
+func TestSimulator_PreemptionDoesNotInflateOutputTokens(t *testing.T) {
+	seed := int64(42)
+	// High arrival rate (1 req/tick) with many concurrent requests forces KV pressure.
+	// Block size of 1 token maximizes per-token block allocation, amplifying contention.
+	requests := testGenerateRequests(seed, math.MaxInt64, 1.0, 20,
+		0, 30, 5, 10, 50, 20, 5, 10, 40)
+
+	run := func(kvBlocks, blockSize int64) (outputTokens int, preemptions int64) {
+		cfg := SimConfig{
+			Horizon:             math.MaxInt64,
+			Seed:                seed,
+			KVCacheConfig:       NewKVCacheConfig(kvBlocks, blockSize, 0, 0, 0, 0),
+			BatchConfig:         NewBatchConfig(256, 2048, 0),
+			LatencyCoeffs:       NewLatencyCoeffs([]float64{1000, 10, 5}, []float64{100, 1, 100}),
+			ModelHardwareConfig: NewModelHardwareConfig(ModelConfig{}, HardwareCalib{}, "test-preemption", "H100", 1, "blackbox", 0),
+		}
+		sim := mustNewSimulator(t, cfg)
+		for _, r := range requests {
+			cp := *r
+			cp.ITL = nil
+			cp.TTFTSet = false
+			sim.InjectArrival(&cp)
+		}
+		sim.Run()
+		if sim.Metrics.CompletedRequests != len(requests) {
+			t.Fatalf("kvBlocks=%d: completed %d, want %d", kvBlocks, sim.Metrics.CompletedRequests, len(requests))
+		}
+		return sim.Metrics.TotalOutputTokens, sim.Metrics.PreemptionCount
+	}
+
+	largeTokens, largePreemptions := run(50000, 1)
+	smallTokens, smallPreemptions := run(100, 1)
+
+	if largePreemptions != 0 {
+		t.Fatalf("large KV: expected 0 preemptions, got %d", largePreemptions)
+	}
+	if smallPreemptions == 0 {
+		t.Fatal("small KV: expected preemptions but got 0; test is vacuous")
+	}
+	if smallTokens != largeTokens {
+		t.Errorf("TotalOutputTokens inflated by preemption: small_kv=%d, large_kv=%d (preemptions=%d)",
+			smallTokens, largeTokens, smallPreemptions)
+	}
+}
