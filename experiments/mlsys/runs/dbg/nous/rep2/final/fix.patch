+	// Record preemption metrics and correct double-counted metrics.
+	// When a request is preempted, its ProgressIndex is reset to 0 and it
+	// re-enters prefill+decode from scratch. Output tokens and TTFT recorded
+	// during the previous scheduling round would be counted again, so we
+	// subtract them here to keep TotalOutputTokens and TTFTSum accurate.
 	for _, p := range batchResult.Preempted {
 		logrus.Debugf("<< Preemption: %s at %d ticks", p.Request.ID, now)
 		sim.Metrics.PreemptionCount++
+		sim.Metrics.TotalOutputTokens -= int(p.OutputTokensGenerated)
+		if p.Request.TTFTSet {
+			sim.Metrics.TTFTSum -= p.Request.FirstTokenTime
+			p.Request.TTFTSet = false
+		}
+		p.Request.ITL = nil
 	}
 
