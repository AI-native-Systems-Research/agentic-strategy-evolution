index 5b438c2..69120b7 100644
--- a/sim/simulator_test.go
+++ b/sim/simulator_test.go
@@ -2598,3 +2598,77 @@ func TestEnqueueDecodeSubRequest_SimClockAhead_StepEventAtSimClock(t *testing.T)
