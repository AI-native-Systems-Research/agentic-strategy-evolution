+
+// TestPreemption_TotalOutputTokens_NoDoubleCount verifies that TotalOutputTokens
+// is not inflated by preemption. When a request is preempted, its ProgressIndex
+// resets to 0, but the decode tokens already counted must be subtracted so they
+// are not counted again when the request is rescheduled.
+//
+// Regression test for the bug: "total_output_tokens too high when KV cache is
+// small enough that requests get preempted."
+func TestPreemption_TotalOutputTokens_NoDoubleCount(t *testing.T) {
+	// Use the same workload with two different KV cache sizes:
+	// - Large cache (no preemptions): ground truth for TotalOutputTokens
+	// - Small cache (forces preemptions): must match ground truth
+	seed := int64(42)
+	numReqs := 50
+	rate := 50.0 / 1e6 // 50 req/s in ticks — high rate ensures request overlap
+
+	makeRequests := func() []*Request {
+		return testGenerateRequests(seed, math.MaxInt64, rate, numReqs,
+			0, 100, 20, 30, 200, 50, 10, 10, 100)
+	}
+
+	baseCfg := SimConfig{
+		Horizon:             math.MaxInt64,
+		Seed:                seed,
+		BatchConfig:         NewBatchConfig(256, 2048, 0),
+		LatencyCoeffs:       NewLatencyCoeffs([]float64{1000, 10, 5}, []float64{100, 1, 100}),
+		ModelHardwareConfig: NewModelHardwareConfig(ModelConfig{}, HardwareCalib{}, "test", "H100", 1, "blackbox", 0),
+	}
+
+	// Run 1: large cache — no preemptions (ground truth)
+	largeCfg := baseCfg
+	largeCfg.KVCacheConfig = NewKVCacheConfig(10000, 16, 0, 0, 0, 0)
+	simLarge := mustNewSimulator(t, largeCfg)
+	injectRequests(simLarge, makeRequests())
+	simLarge.Run()
+
+	if simLarge.Metrics.PreemptionCount != 0 {
+		t.Fatalf("large-cache run had %d preemptions, want 0 (test precondition)",
+			simLarge.Metrics.PreemptionCount)
+	}
+	groundTruth := simLarge.Metrics.TotalOutputTokens
+	if groundTruth == 0 {
+		t.Fatal("ground truth TotalOutputTokens is 0 — test is vacuous")
+	}
+
+	// Run 2: small cache — forces preemptions.
+	// Each request needs ~7 blocks for input (100 tokens / 16 per block) plus
+	// decode blocks. With 50 fast-arriving requests competing for 30 blocks,
+	// preemption is guaranteed.
+	smallCfg := baseCfg
+	smallCfg.KVCacheConfig = NewKVCacheConfig(30, 16, 0, 0, 0, 0)
+	simSmall := mustNewSimulator(t, smallCfg)
+	injectRequests(simSmall, makeRequests())
+	simSmall.Run()
+
+	if simSmall.Metrics.PreemptionCount == 0 {
+		t.Fatal("small-cache run had 0 preemptions — test is vacuous (increase load or shrink cache)")
+	}
+
+	// Both runs must complete all requests (same workload, infinite horizon)
+	if simSmall.Metrics.CompletedRequests != simLarge.Metrics.CompletedRequests {
+		t.Errorf("completed requests mismatch: small=%d large=%d",
+			simSmall.Metrics.CompletedRequests, simLarge.Metrics.CompletedRequests)
+	}
+
+	// CORE ASSERTION: TotalOutputTokens must be identical regardless of preemptions.
+	// Before the fix, the small-cache run double-counted decode tokens for preempted
+	// requests, inflating TotalOutputTokens.
+	if simSmall.Metrics.TotalOutputTokens != groundTruth {
+		t.Errorf("TotalOutputTokens double-counting: small-cache=%d, large-cache=%d (preemptions=%d); "+
+			"want identical counts regardless of preemptions",
+			simSmall.Metrics.TotalOutputTokens, groundTruth, simSmall.Metrics.PreemptionCount)
+	}
+}
