# ─────────────────────────────────────────────────────────────────────────────
# Nous s390x deployment — environment variables template
#
# Usage:
#   cp s390x/.env.example s390x/.env
#   # Edit s390x/.env and fill in your values
#   # .env is gitignored; .env.example is committed as documentation
# ─────────────────────────────────────────────────────────────────────────────

# ── Remote s390x target ───────────────────────────────────────────────────────

# Hostname of the remote IBM Z / s390x machine to deploy to
REMOTE_HOST=

# SSH login user on the remote host
REMOTE_USER=

# Path to the SSH private key on the LOCAL machine (leave empty to use password auth)
SSH_KEY=

# SSH password — only used when SSH_KEY is empty (requires sshpass installed locally).
# Passed to sshpass via the SSHPASS environment variable (never on the command line)
# to avoid exposure in `ps` output.
SSH_PASSWORD=

# Working directory on the remote host where build context is staged
REMOTE_WORKDIR=/home/<user>/nous

# ── Image ────────────────────────────────────────────────────────────────────

IMAGE_NAME=nous
IMAGE_TAG=0.4.0

# claude-code CLI version baked into the image.
# Passed to `podman build --build-arg CLAUDE_CODE_VERSION=<value>` when set.
# Defaults to the ARG default in the Dockerfile (2.1.112) when left empty.
CLAUDE_CODE_VERSION=2.1.112

# ── Anthropic / Claude credentials ───────────────────────────────────────────

# API key for the Claude Agent SDK and the claude CLI subprocess.
# Required — the framework will not start without this.
ANTHROPIC_API_KEY=

# Optional: override the Anthropic API base URL (e.g. a LiteLLM proxy).
# When unset, claude CLI defaults to https://api.anthropic.com.
ANTHROPIC_BASE_URL=

# ── OpenAI-compatible LLM (gate summaries & report generation) ───────────────

# API key for the OpenAI-compatible endpoint used by LLMDispatcher.
# Optional — gate summaries and nous report are skipped when unset.
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint (LiteLLM proxy, vLLM, etc.).
# Optional — defaults to the public OpenAI endpoint when unset.
OPENAI_BASE_URL=

# ── Nous framework ───────────────────────────────────────────────────────────

# Directory on the REMOTE host to store campaign artifacts (host side of the mount).
# This is bind-mounted into the container at /opt/app-root/src/campaigns.
NOUS_CAMPAIGN_HOST_DIR=/home/<user>/nous/campaigns

# Path inside the container where campaign artifacts land.
# Must match the directory created in the Dockerfile (/opt/app-root/src/campaigns).
# Also exported into the container as NOUS_CAMPAIGN_PARENT so Nous writes there.
NOUS_CAMPAIGN_PARENT=/opt/app-root/src/campaigns

# Set to "1" to allow --auto-approve without an interactive terminal.
# Leave empty (or unset) for interactive gate review.
NOUS_ALLOW_AUTO_APPROVE=1

# ── Target repository ─────────────────────────────────────────────────────────

# Git URL of the repository Nous will experiment on.
# Supports HTTPS (with TOKEN) and SSH (key must be configured on remote host).
# Example uses the public Flask repo — no token needed.
TARGET_REPO_GIT_URL=https://github.com/pallets/flask.git

# Branch (or tag / commit SHA) to check out.
TARGET_REPO_BRANCH=main

# Personal access token (or app token) for private HTTPS repos.
# Injected as a git credential at clone/pull time — never stored in the repo.
# Leave empty for public repos or SSH-based access.
TARGET_REPO_TOKEN=

# Absolute path on the REMOTE host where the repo is cloned.
# Mounted read-write into the container at /workspace.
# run_campaign.sh clones/updates this path automatically when TARGET_REPO_GIT_URL is set.
TARGET_REPO_PATH=/home/<user>/nous/flask

# Path to the campaign.yaml on the LOCAL machine (relative to this .env file,
# or absolute). run_campaign.sh copies this file to the remote host and mounts it
# into the container at /campaign/campaign.yaml.
# The included campaign.yaml investigates Flask routing overhead.
LOCAL_CAMPAIGN_YAML=./campaign.yaml

# Path inside the container where campaign.yaml is mounted.
# Fixed — do not change unless you also change the mount in run_campaign.sh.
CAMPAIGN_YAML=/campaign/campaign.yaml

# ── Local output ──────────────────────────────────────────────────────────────

# Local directory where campaign artifacts are rsynced after the run completes.
# Contains state.json, ledger.json, principles.json, findings.json, report.md, etc.
# Relative paths are resolved against the s390x/ directory.
LOCAL_ARTIFACTS_DIR=./campaigns

# ── Campaign run parameters ───────────────────────────────────────────────────

# Maximum number of experiment iterations (--max-iterations).
NOUS_MAX_ITERATIONS=5

# Per-phase timeout in seconds (--timeout).
NOUS_TIMEOUT=1800

# Maximum claude CLI retries per phase (--max-cli-retries).
# -1 means unlimited retries (never give up on transient failures).
NOUS_MAX_CLI_RETRIES=10

# ── Optional overrides ────────────────────────────────────────────────────────

# Override the Anthropic Routines API base URL (default: https://api.anthropic.com/v1/routines)
ROUTINES_API_BASE=

# Set to "1" to disable extended thinking in the claude CLI.
CLAUDE_CODE_DISABLE_THINKING=

# Container name (used by run_campaign.sh to manage stop/restart)
CONTAINER_NAME=nous-s390x
