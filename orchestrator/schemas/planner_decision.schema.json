{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nous plan-next decision (WP-D D2)",
  "description": "Written by `nous plan-next` (orchestrator/optimize/planner.py) at plan_next/epoch-<e>/planner_decision.json. A logged allocation decision made BEFORE the data it affects exist: the scored candidate next epochs, the stated utility and its approximation, the stopping threshold, the assumptions, the cross-epoch error and run budgets, the scored choice and any recorded override. Zero model tokens. It decides no certificate: the next epoch is compiled, pre-registered and certified on its own fresh measurements.",
  "type": "object",
  "required": ["planner_version", "epoch", "tokens", "inputs", "model", "utility", "stopping",
               "assumptions", "error_budget", "options", "chosen", "decision_basis",
               "scored_choice", "override", "proposed_campaign"],
  "properties": {
    "planner_version": {"const": 1},
    "work_dir": {"type": "string"},
    "epoch": {"type": "integer", "minimum": 1},
    "decided_at": {"type": "string"},
    "tokens": {"const": 0},
    "inputs": {"type": "object", "description": "sha256 of every file the decision read; `--accept` refuses a stale decision.",
               "additionalProperties": {"type": "string"}},
    "model": {"type": "object", "required": ["model_adequate"],
              "properties": {"model_adequate": {"type": ["boolean", "null"]},
                             "declined": {"type": "string"}, "detail": {"type": "string"}}},
    "utility": {"type": "object", "required": ["name", "definition", "computed_as", "units"],
                "properties": {"name": {"enum": ["expected_improvement_per_run",
                                                 "expected_hypervolume_improvement_per_run"]}}},
    "stopping": {"type": "object", "required": ["threshold_per_run", "rule"],
                 "properties": {"threshold_per_run": {"type": ["number", "null"]},
                                "rule": {"type": "string"}}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "error_budget": {"type": "object", "required": ["cumulative", "mode"],
                     "properties": {"cumulative": {"type": ["number", "null"]},
                                    "mode": {"enum": ["charged", "informational"]},
                                    "remaining": {"type": "number"},
                                    "campaign_total": {"type": "number"},
                                    "runs_remaining": {"type": "integer"}}},
    "bo": {"type": "object"},
    "options": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "kind", "feasible", "score"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["pin_dead", "narrow", "widen_edge", "raise_resolution",
                          "recombination", "bo_block", "replicate", "stop"]},
        "feasible": {"type": "boolean"},
        "score": {"type": ["number", "null"]},
        "reason": {"type": "string"},
        "unscored": {"type": "string"},
        "cost_runs": {"type": ["integer", "null"]},
        "error_budget": {"type": "object", "required": ["next_epoch_delta", "fits"],
                         "properties": {"fits": {"type": "boolean"}}},
        "changes": {"type": "array", "items": {"type": "string"}}
      }}},
    "chosen": {"type": "string"},
    "decision_basis": {"enum": ["max_value_per_run_above_threshold", "no_move_beats_threshold",
                                "no_feasible_move", "no_scorable_move", "threshold_undefined"]},
    "scored_choice": {"type": "string"},
    "override": {"oneOf": [{"type": "null"},
                           {"type": "object", "required": ["chosen", "reason", "scored_choice"],
                            "properties": {"reason": {"type": "string", "minLength": 1}}}]},
    "proposed_campaign": {"oneOf": [{"type": "null"},
                                    {"type": "object", "required": ["path", "diff", "campaign_hash"]}]},
    "model_free_alternatives": {"type": "array", "items": {"type": "string"}},
    "front_points": {"type": "integer"}
  }
}
