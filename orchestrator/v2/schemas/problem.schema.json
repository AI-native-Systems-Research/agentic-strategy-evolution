{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nous v2 problem artifact",
  "type": "object",
  "required": ["task_type", "claims_needed"],
  "properties": {
    "task_type": {
      "type": "string",
      "enum": ["debug", "verify", "optimize", "policy", "explain", "other"]
    },
    "claims_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "test_method"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "test_method": { "type": "string" },
          "min_seeds": { "type": "integer", "minimum": 1 },
          "needs_ci": { "type": "boolean" },
          "conditions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "extra": { "type": "object" }
  },
  "additionalProperties": false
}
